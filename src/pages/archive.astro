---
export const prerender = false;

import { env } from "cloudflare:workers";
import { Archive, ArrowRight, CalendarDays, ChevronLeft, ChevronRight, Database, Filter, House, Layers3, LayoutGrid, List, PanelsTopLeft, Search } from "lucide-astro";
import Base from "../layouts/Base.astro";
import { CATEGORY_LABELS, categoryLabel, type Category } from "../lib/categories";
import {
  getArchiveFacets,
  getContentStats,
  listArchiveDays,
  listArchivedContentItems,
  type OriginType,
} from "../lib/content";
import { createDb } from "../db/client";
import { formatKstDate, formatShortDate, kstDayRange, todayKstRange } from "../lib/dates";
import { excerpt } from "../lib/text";

const SOURCE_LABELS: Record<OriginType, string> = {
  gov: "공공데이터",
  news: "뉴스·RSS",
  youtube: "YouTube",
  ai_trivia: "AI 상식",
};

const db = createDb(env.DB);
const params = Astro.url.searchParams;
const categoryParam = params.get("category");
const activeCategory = (categoryParam && categoryParam in CATEGORY_LABELS ? categoryParam : undefined) as Category | undefined;
const sourceParam = params.get("source");
const activeSource = (sourceParam && sourceParam in SOURCE_LABELS ? sourceParam : undefined) as OriginType | undefined;
const dateParam = params.get("date");
const parsedDate = dateParam ? kstDayRange(dateParam) : null;
const today = todayKstRange();
const activeDate = parsedDate && parsedDate.start < today.start ? parsedDate.key : undefined;
const activeQuery = params.get("q")?.replace(/\s+/g, " ").trim().slice(0, 60) || undefined;
const pageParam = Number(params.get("page") ?? 1);

const [archive, days, facets, stats] = await Promise.all([
  listArchivedContentItems(db, {
    category: activeCategory,
    date: activeDate,
    originType: activeSource,
    query: activeQuery,
    page: pageParam,
  }),
  listArchiveDays(db, new Date(), 366),
  getArchiveFacets(db),
  getContentStats(db),
]);

// Cached at the edge: archive facets only shift when new content ships on
// the ingestion cron, so short-lived edge caching avoids re-querying D1 for
// every visitor browsing the same filter combination.
Astro.response.headers.set("cache-control", "public, max-age=90, stale-while-revalidate=600");

const categoryCounts = new Map(facets.categoryCounts.map((facet) => [facet.category, facet.count]));
const sourceCounts = new Map(facets.sourceCounts.map((facet) => [facet.originType, facet.count]));
const hasActiveFilters = Boolean(activeCategory || activeSource || activeDate || activeQuery);

function archiveHref(overrides: { category?: string | null; date?: string | null; source?: string | null; query?: string | null; page?: number | null }) {
  const next = new URLSearchParams();
  const values = {
    category: overrides.category === undefined ? activeCategory : overrides.category,
    date: overrides.date === undefined ? activeDate : overrides.date,
    source: overrides.source === undefined ? activeSource : overrides.source,
    query: overrides.query === undefined ? activeQuery : overrides.query,
  };

  if (values.category) next.set("category", values.category);
  if (values.date) next.set("date", values.date);
  if (values.source) next.set("source", values.source);
  if (values.query) next.set("q", values.query);
  const page = overrides.page ?? 1;
  if (page > 1) next.set("page", String(page));
  const query = next.toString();
  return query ? `/archive?${query}` : "/archive";
}
---

<Base title="지난 상식 보관함" description="00시 이전 라이프퀴즈 콘텐츠를 날짜, 분야, 출처와 페이지별로 찾아봅니다.">
  <div class="archive-page shell">
    <header class="archive-header">
      <div>
        <p class="eyebrow">KNOWLEDGE ARCHIVE</p>
        <h1 class="page-title">지난 상식 보관함</h1>
        <p>매일 00시를 기준으로 지난 데이터가 이곳에 차곡차곡 정리됩니다.</p>
      </div>
      <a class="button button-primary" href="/"><House size={17} /> 오늘 상식 보기</a>
    </header>

    <section class="archive-summary" aria-label="보관함 현황">
      <div><Archive size={20} /><span>보관된 상식</span><strong>{stats.archive}</strong></div>
      <div><CalendarDays size={20} /><span>기록된 날짜</span><strong>{days.length}</strong></div>
      <div><Layers3 size={20} /><span>분야</span><strong>{facets.categoryCounts.length}</strong></div>
      <div><Database size={20} /><span>전체 누적</span><strong>{stats.total}</strong></div>
    </section>

    <section class="filter-panel" aria-labelledby="filter-title">
      <div class="filter-panel-heading">
        <span><Filter size={15} /><strong id="filter-title">원하는 상식 찾기</strong></span>
        {hasActiveFilters && <a class="reset-link" href="/archive">모든 조건 지우기</a>}
      </div>
      <form class="archive-toolbar" method="get" action="/archive" role="search">
        <label class="search-field" for="archive-query">
          <span>검색어</span>
          <i><Search size={17} aria-hidden="true" /><input id="archive-query" name="q" type="search" value={activeQuery} maxlength="60" placeholder="제목, 내용, 출처 검색" /></i>
        </label>
        <label class="filter-field" for="category-select">
          <span>분야</span>
          <select id="category-select" name="category">
            <option value="">전체 분야 ({stats.archive})</option>
            {Object.entries(CATEGORY_LABELS).map(([key, label]) => (
              <option value={key} selected={activeCategory === key}>{label} ({categoryCounts.get(key as Category) ?? 0})</option>
            ))}
          </select>
        </label>
        <label class="filter-field" for="date-select">
          <span>날짜</span>
          <select id="date-select" name="date">
            <option value="">모든 날짜 ({stats.archive})</option>
            {days.map((day) => <option value={day.day} selected={activeDate === day.day}>{formatKstDate(day.day, false)} ({day.count})</option>)}
          </select>
        </label>
        <label class="filter-field" for="source-select">
          <span>출처</span>
          <select id="source-select" name="source">
            <option value="">모든 출처</option>
            {Object.entries(SOURCE_LABELS).map(([key, label]) => (
              <option value={key} selected={activeSource === key}>{label} ({sourceCounts.get(key as OriginType) ?? 0})</option>
            ))}
          </select>
        </label>
        <button class="button button-primary" type="submit"><Search size={16} /> 검색</button>
      </form>
    </section>

    <section class="archive-results" aria-labelledby="results-title">
      <div class="results-heading">
        <div>
          <p class="eyebrow">RESULTS</p>
          <h2 id="results-title">{activeDate ? formatKstDate(activeDate) : activeQuery ? `“${activeQuery}” 검색 결과` : "이전 데이터 전체"}</h2>
          <p><strong>{archive.total}</strong>개의 상식 · {archive.page} / {archive.totalPages} 페이지</p>
        </div>
        <div class="view-switcher" role="group" aria-label="결과 보기 방식">
          <button type="button" data-archive-view="grid" aria-label="카드 보기" aria-pressed="true" title="카드 보기"><LayoutGrid size={17} /></button>
          <button type="button" data-archive-view="list" aria-label="목록 보기" aria-pressed="false" title="목록 보기"><List size={18} /></button>
        </div>
      </div>

        {archive.items.length > 0 ? (
          <ul class="archive-grid" id="archive-results-list" data-view="grid">
            {archive.items.map((item) => (
              <li>
                <a class="archive-card" href={`/articles/${item.id}`}>
                  <div class="card-topline">
                    <div class="card-tags">
                      <span class="category-label" data-category={item.category}>{categoryLabel(item.category)}</span>
                      {item.contentFormat === "visual_guide" && <span class="visual-format-badge"><PanelsTopLeft size={13} /> 4컷 용어</span>}
                    </div>
                    <span class="source-type">{item.originType ? SOURCE_LABELS[item.originType] : "기타"}</span>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.cards?.[0]?.body ?? excerpt(item.bodyMd)}</p>
                  <div class="card-footer">
                    <span>{item.citationLabel}</span>
                    <span>{formatShortDate(item.createdAt)}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="archive-empty">
            <Archive size={32} />
            <h3>조건에 맞는 지난 상식이 없어요</h3>
            <p>필터를 초기화하거나 다른 날짜를 선택해보세요.</p>
            <a class="button button-primary" href="/archive">전체 보관함 보기</a>
          </div>
        )}

        {archive.totalPages > 1 && (
          <nav class="pagination" aria-label="보관함 페이지">
            {archive.page > 1 ? (
              <a class="button button-secondary" href={archiveHref({ page: archive.page - 1 })}><ChevronLeft size={17} /> 이전</a>
            ) : <span class="button button-secondary disabled"><ChevronLeft size={17} /> 이전</span>}
            <span class="page-status"><strong>{archive.page}</strong><span>/</span>{archive.totalPages}</span>
            {archive.page < archive.totalPages ? (
              <a class="button button-secondary" href={archiveHref({ page: archive.page + 1 })}>다음 <ChevronRight size={17} /></a>
            ) : <span class="button button-secondary disabled">다음 <ChevronRight size={17} /></span>}
          </nav>
        )}
    </section>

    <a class="today-banner" href="/">
      <div><span>오늘의 새 상식</span><strong>{stats.today}개가 기다리고 있어요</strong></div>
      <ArrowRight size={21} />
    </a>
  </div>
</Base>

<style>
  .archive-page {
    padding-top: 44px;
  }

  .archive-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 28px;
  }

  .archive-header p:not(.eyebrow) {
    margin: 10px 0 0;
    color: var(--muted);
  }

  .archive-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  .archive-summary > div {
    min-width: 0;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 18px 20px;
    border-right: 1px solid var(--line);
  }

  .archive-summary > div:last-child { border-right: 0; }
  .archive-summary svg { color: var(--green); }
  .archive-summary span { color: var(--muted); font-size: 0.78rem; }
  .archive-summary strong { font-size: 1.2rem; }

  .filter-panel {
    margin-bottom: 28px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  .filter-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 11px;
  }

  .filter-panel-heading > span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted-strong);
    font-size: 0.78rem;
  }

  .filter-panel-heading svg { color: var(--green); }
  .reset-link { color: var(--green-deep); font-size: 0.72rem; font-weight: 750; }

  .archive-toolbar {
    display: grid;
    grid-template-columns: minmax(220px, 1.8fr) repeat(3, minmax(140px, 1fr)) auto;
    align-items: end;
    gap: 9px;
  }

  .search-field,
  .filter-field { min-width: 0; display: grid; gap: 5px; }
  .search-field > span,
  .filter-field > span { color: var(--muted); font-size: 0.66rem; font-weight: 750; }

  .search-field i {
    min-width: 0;
    min-height: 42px;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 0 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--muted);
    background: var(--surface);
    font-style: normal;
  }

  .search-field i:focus-within { border-color: color-mix(in srgb, var(--green) 48%, var(--line)); background: var(--paper); }
  .search-field input { min-width: 0; width: 100%; border: 0; background: transparent; }
  .filter-field select { min-width: 0; width: 100%; min-height: 42px; padding: 0 9px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); font-size: 0.76rem; }
  .archive-toolbar .button { min-height: 42px; }

  .archive-results {
    min-width: 0;
  }

  .results-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .results-heading h2 { margin: 0; font-size: 1.22rem; }
  .results-heading p:not(.eyebrow) { margin: 4px 0 0; color: var(--muted); font-size: 0.78rem; }
  .results-heading p strong { color: var(--ink); }

  .view-switcher {
    width: 82px;
    height: 40px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  .view-switcher button { display: grid; place-items: center; border-radius: 5px; color: var(--muted); background: transparent; cursor: pointer; }
  .view-switcher button[aria-pressed="true"] { color: var(--green-deep); background: var(--green-soft); }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-grid li { min-width: 0; }

  .archive-card {
    min-height: 196px;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .archive-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--green) 35%, var(--line));
  }

  .card-topline,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .source-type {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .card-tags {
    min-width: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
  }

  .archive-card h3 {
    display: -webkit-box;
    margin: 13px 0 7px;
    overflow: hidden;
    font-size: 0.92rem;
    line-height: 1.42;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .archive-card > p {
    display: -webkit-box;
    margin: 0 0 18px;
    overflow: hidden;
    color: var(--muted-strong);
    font-size: 0.76rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .card-footer span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-grid[data-view="list"] { grid-template-columns: 1fr; }
  .archive-grid[data-view="list"] .archive-card { min-height: 132px; padding: 15px 18px; }
  .archive-grid[data-view="list"] .archive-card h3 { margin: 10px 0 5px; font-size: 0.95rem; -webkit-line-clamp: 1; }
  .archive-grid[data-view="list"] .archive-card > p { margin-bottom: 10px; -webkit-line-clamp: 1; }
  .archive-grid[data-view="list"] .card-footer { padding-top: 8px; }

  .archive-empty {
    display: grid;
    justify-items: center;
    padding: 64px 20px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    text-align: center;
  }

  .archive-empty h3 { margin: 14px 0 4px; }
  .archive-empty p { margin: 0 0 20px; color: var(--muted); }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }

  .pagination .disabled {
    cursor: default;
    opacity: 0.45;
  }

  .page-status {
    min-width: 64px;
    display: flex;
    justify-content: center;
    gap: 5px;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .page-status strong { color: var(--ink); }

  .today-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    padding: 22px 24px;
    border-radius: var(--radius-md);
    color: white;
    background: var(--green);
    text-decoration: none;
  }

  .today-banner div { display: grid; gap: 2px; }
  .today-banner span { color: #c6e4d6; font-size: 0.74rem; }
  .today-banner strong { font-size: 1.05rem; }

  @media (max-width: 900px) {
    .archive-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .archive-summary > div:nth-child(2) { border-right: 0; }
    .archive-summary > div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }

    .archive-toolbar { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .search-field { grid-column: span 2; }
    .archive-toolbar .button { grid-column: span 2; }
    .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .archive-page { padding-top: 30px; }
    .archive-header { align-items: stretch; flex-direction: column; }
    .archive-header .button { width: 100%; }
    .archive-summary > div { grid-template-columns: 24px minmax(0, 1fr) auto; padding: 15px 12px; }
    .archive-summary span { font-size: 0.7rem; }
    .archive-summary strong { font-size: 1rem; }
    .archive-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .search-field { grid-column: 1 / -1; }
    .archive-toolbar .button { grid-column: 1 / -1; }
    .results-heading { align-items: center; }
    .archive-grid { grid-template-columns: 1fr; }
    .archive-card { min-height: 0; }
    .pagination { gap: 8px; }
    .pagination .button { padding-inline: 10px; }
  }
</style>

<script>
  const archiveViewKey = "life-quiz-archive-view";
  const archiveList = document.querySelector<HTMLElement>("#archive-results-list");
  const archiveViewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-archive-view]"));

  const applyArchiveView = (view: "grid" | "list", persist = false) => {
    if (!archiveList) return;
    archiveList.dataset.view = view;
    archiveViewButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.archiveView === view)));
    if (persist) {
      try { localStorage.setItem(archiveViewKey, view); } catch {}
    }
  };

  let initialArchiveView: "grid" | "list" = "grid";
  try {
    if (localStorage.getItem(archiveViewKey) === "list") initialArchiveView = "list";
  } catch {}
  applyArchiveView(initialArchiveView);

  archiveViewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const view = button.dataset.archiveView;
      if (view === "grid" || view === "list") applyArchiveView(view, true);
    });
  });
</script>
