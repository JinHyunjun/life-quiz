---
export const prerender = false;

import { env } from "cloudflare:workers";
import {
  Archive,
  ArrowRight,
  BookOpen,
  CalendarDays,
  MapPinned,
  MessageCircle,
  Network,
  PanelsTopLeft,
  RotateCcw,
  Sparkles,
} from "lucide-astro";
import Base from "../layouts/Base.astro";
import FirstVisitOnboarding from "../components/FirstVisitOnboarding.astro";
import { createDb } from "../db/client";
import {
  getContentStats,
  getTodayCategoryCounts,
  listArchiveDays,
  listRecentAiDiscoveries,
  listRecentDistrictBriefs,
  listRecentVisualGuides,
  listTodayContentItems,
} from "../lib/content";
import { CATEGORY_LABELS, categoryLabel, type Category } from "../lib/categories";
import { formatKstDate, formatShortDate, todayKstRange } from "../lib/dates";
import { excerpt } from "../lib/text";
import { getLifeQuizSession } from "../lib/auth";
import { hasGuestAccess } from "../lib/guest-access";

const session = await getLifeQuizSession(Astro.request, env.DB, env.BETTER_AUTH_SECRET);
if (!session && !hasGuestAccess(Astro.request)) {
  return Astro.redirect("/login?returnTo=%2F");
}

const db = createDb(env.DB);
const categoryParam = Astro.url.searchParams.get("category");
const activeCategory = (categoryParam && categoryParam in CATEGORY_LABELS ? categoryParam : undefined) as Category | undefined;
const now = new Date();
const today = todayKstRange(now);
const [items, stats, archiveDays, visualGuides, aiDiscoveries, categoryCountRows, districtBriefs] = await Promise.all([
  listTodayContentItems(db, activeCategory, now),
  getContentStats(db, now),
  listArchiveDays(db, now, 3),
  listRecentVisualGuides(db, activeCategory, 3, today.start),
  listRecentAiDiscoveries(db, activeCategory, 4, today.start),
  getTodayCategoryCounts(db, now),
  listRecentDistrictBriefs(db, 3, today.start),
]);

Astro.response.headers.set("cache-control", "private, no-store");

const todayCategoryCounts = new Map(categoryCountRows.map(({ category, count }) => [category, count]));
const categories = Object.entries(CATEGORY_LABELS) as [Category, string][];
const featured = items[0];
const feedItems = items.slice(1);
const exploreItems = [
  ...visualGuides.slice(0, 2).map((item) => ({ ...item, kind: "4컷 용어", icon: PanelsTopLeft })),
  ...districtBriefs.slice(0, 2).map((item) => ({ ...item, kind: "서울 브리핑", icon: MapPinned })),
  ...aiDiscoveries.slice(0, 2).map((item) => ({ ...item, kind: "큐레이션", icon: Sparkles })),
].filter((item, index, all) => all.findIndex((candidate) => candidate.id === item.id) === index).slice(0, 6);
---

<Base title="읽고, 묻고, 오래 기억하는 생활 상식">
  <FirstVisitOnboarding />

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-content shell">
      <div class="hero-status"><Sparkles size={15} /> 오늘 {stats.today}개 업데이트</div>
      <h1 id="hero-title">사회초년생을 위한<br />오늘의 생활 상식</h1>
      <p>필요한 것부터 짧게 읽고, 퀴즈로 오래 기억하세요.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/daily"><RotateCcw size={17} /> 5분 학습 시작</a>
        <a class="hero-link" href="/chat"><MessageCircle size={17} /> AI에게 질문</a>
        <a class="hero-link" href="/archive"><Archive size={17} /> 지난 상식</a>
      </div>
    </div>
  </section>

  <div class="home-page shell">
    <section class="category-section" aria-labelledby="category-title">
      <div class="compact-heading">
        <div>
          <span class="section-kicker">분야별 탐색</span>
          <h2 id="category-title">오늘 무엇이 궁금한가요?</h2>
        </div>
        <a href="/topics">지식 지도 <Network size={15} /></a>
      </div>

      <nav class="topic-strip" aria-label="콘텐츠 분야">
        <a class:list={["topic-link all", { active: !activeCategory }]} href="/" aria-current={!activeCategory ? "page" : undefined}>
          <span>전체</span><strong>{stats.today}</strong>
        </a>
        {categories.map(([category, label]) => (
          <a
            class:list={["topic-link", { active: activeCategory === category }]}
            href={`/?category=${category}`}
            aria-current={activeCategory === category ? "page" : undefined}
            data-category={category}
          >
            <span><i class="category-swatch"></i>{label}</span>
            <strong>{todayCategoryCounts.get(category) ?? 0}</strong>
          </a>
        ))}
      </nav>
    </section>

    <div class="home-dashboard">
      <main class="today-feed">
        {featured ? (
          <>
            <section class="featured-section" aria-labelledby="featured-title">
              <div class="compact-heading">
                <div>
                  <span class="section-kicker">오늘의 핵심</span>
                  <h2 id="featured-title">가장 먼저 볼 상식</h2>
                </div>
                <span>{formatShortDate(featured.createdAt)}</span>
              </div>

              <a class="featured-story" href={`/articles/${featured.id}`} data-category={featured.category}>
                <div class="featured-accent"><BookOpen size={22} /></div>
                <div class="featured-copy">
                  <div class="content-tags">
                    <span class="category-label">{categoryLabel(featured.category)}</span>
                    {featured.contentFormat === "visual_guide" && <span class="visual-format-badge"><PanelsTopLeft size={13} /> 4컷 용어</span>}
                  </div>
                  <h3>{featured.title}</h3>
                  <p>{featured.cards?.[0]?.body ?? excerpt(featured.bodyMd, 130)}</p>
                  <small>{featured.citationLabel}</small>
                </div>
                <ArrowRight class="featured-arrow" size={22} aria-hidden="true" />
              </a>
            </section>

            {feedItems.length > 0 && (
              <section class="feed-section" aria-labelledby="feed-title">
                <div class="compact-heading">
                  <div>
                    <span class="section-kicker">새로 도착함</span>
                    <h2 id="feed-title">오늘 쌓인 상식</h2>
                  </div>
                  <span>{feedItems.length}개</span>
                </div>

                <ul class="content-list">
                  {feedItems.map((item) => (
                    <li>
                      <a class="content-row" href={`/articles/${item.id}`} data-category={item.category}>
                        <span class="row-marker" aria-hidden="true"></span>
                        <span class="row-copy">
                          <span class="row-meta">
                            <strong>{categoryLabel(item.category)}</strong>
                            {item.contentFormat === "visual_guide" && <b>4컷</b>}
                            <time>{formatShortDate(item.createdAt)}</time>
                          </span>
                          <span class="row-title">{item.title}</span>
                          <span class="row-summary">{item.cards?.[0]?.body ?? excerpt(item.bodyMd, 90)}</span>
                        </span>
                        <ArrowRight size={17} aria-hidden="true" />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </>
        ) : (
          <section class="empty-state" aria-labelledby="empty-title">
            <BookOpen size={32} strokeWidth={1.7} />
            <h2 id="empty-title">오늘 이 분야의 새 상식은 아직 없어요</h2>
            <a class="button button-primary" href="/archive">지난 상식에서 찾기</a>
          </section>
        )}
      </main>

      <aside class="home-rail" aria-label="빠른 학습과 추천">
        <section class="quick-panel" aria-labelledby="quick-title">
          <div class="compact-heading">
            <div>
              <span class="section-kicker">바로 시작</span>
              <h2 id="quick-title">지금 할 일</h2>
            </div>
          </div>
          <div class="quick-links">
            <a class="quick-link primary" href="/daily">
              <RotateCcw size={19} /><span><strong>5분 학습</strong><small>오늘의 카드 5장</small></span><ArrowRight size={16} />
            </a>
            <a class="quick-link" href="/review">
              <BookOpen size={19} /><span><strong>복습하기</strong><small>기억할 때 다시 보기</small></span><ArrowRight size={16} />
            </a>
            <a class="quick-link" href="/chat">
              <MessageCircle size={19} /><span><strong>AI에게 묻기</strong><small>출처가 있는 답변</small></span><ArrowRight size={16} />
            </a>
          </div>
        </section>

        {exploreItems.length > 0 && (
          <section class="explore-panel" aria-labelledby="explore-title">
            <div class="compact-heading">
              <div>
                <span class="section-kicker">추천 큐</span>
                <h2 id="explore-title">이어서 둘러보기</h2>
              </div>
              <a href="/archive">더 보기 <ArrowRight size={14} /></a>
            </div>
            <ul class="explore-list">
              {exploreItems.map((item) => {
                const ItemIcon = item.icon;
                return (
                  <li>
                    <a href={`/articles/${item.id}`} data-category={item.category}>
                      <span class="explore-icon"><ItemIcon size={16} /></span>
                      <span><small>{item.kind} · {categoryLabel(item.category)}</small><strong>{item.title}</strong></span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        <a class="archive-panel" href="/archive">
          <span class="archive-icon"><Archive size={19} /></span>
          <span><small>지난 상식 보관함</small><strong>{stats.archive}개에서 찾아보기</strong></span>
          <ArrowRight size={17} />
          {archiveDays.length > 0 && (
            <span class="archive-days">
              {archiveDays.map((day) => <i><CalendarDays size={12} /> {formatKstDate(day.day, false)} {day.count}</i>)}
            </span>
          )}
        </a>
      </aside>
    </div>
  </div>
</Base>

<style>
  .hero { position: relative; min-height: 214px; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--line); background: var(--surface-strong); }
  .hero-image { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(90deg, color-mix(in srgb, var(--paper) 92%, transparent) 0 40%, color-mix(in srgb, var(--paper) 38%, transparent) 68%, transparent), url("/images/life-quiz-desk.webp"); background-position: center; background-size: cover; }
  .hero-content { min-height: 214px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .hero-status, .section-kicker { color: var(--green-deep); font-size: 0.7rem; font-weight: 850; }
  .hero-status { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 6px; }
  .hero h1 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.65rem); line-height: 1.12; }
  .hero-content > p { margin: 7px 0 0; color: var(--muted-strong); font-size: 0.9rem; }
  .hero-actions { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
  .hero-actions .button { min-height: 39px; }
  .hero-link { min-height: 39px; display: inline-flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: var(--radius-sm); color: var(--ink); background: color-mix(in srgb, var(--paper) 84%, transparent); text-decoration: none; font-size: 0.78rem; font-weight: 750; }

  .home-page { padding-top: 24px; padding-bottom: 16px; }
  .category-section { margin-bottom: 26px; }
  .compact-heading { min-width: 0; display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .compact-heading > div { min-width: 0; }
  .compact-heading h2 { margin: 2px 0 0; font-size: 1.08rem; line-height: 1.3; }
  .compact-heading > span { color: var(--muted); font-size: 0.73rem; font-weight: 700; }
  .compact-heading > a { display: inline-flex; align-items: center; gap: 4px; color: var(--green-deep); text-decoration: none; font-size: 0.74rem; font-weight: 800; white-space: nowrap; }

  .topic-strip { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 7px; }
  .topic-link { min-width: 0; min-height: 42px; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 10px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); text-decoration: none; font-size: 0.72rem; font-weight: 750; }
  .topic-link > span { min-width: 0; display: flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topic-link strong { flex: 0 0 auto; color: var(--muted); font-size: 0.68rem; }
  .topic-link:hover { border-color: color-mix(in srgb, var(--category-color, var(--green)) 40%, var(--line)); }
  .topic-link.active { color: var(--green-deep); border-color: color-mix(in srgb, var(--green) 42%, var(--line)); background: var(--green-soft); }
  .topic-link.all { color: var(--contrast-ink); background: var(--contrast-surface); }
  .topic-link.all strong { color: var(--contrast-accent); }

  .home-dashboard { display: grid; grid-template-columns: minmax(0, 1fr) 310px; align-items: start; gap: 24px; }
  .today-feed { min-width: 0; }
  .featured-section { margin-bottom: 28px; }
  .featured-story { min-height: 160px; display: grid; grid-template-columns: 54px minmax(0, 1fr) 42px; align-items: stretch; overflow: hidden; border: 1px solid color-mix(in srgb, var(--category-color) 28%, var(--line)); border-radius: var(--radius-md); color: var(--ink); background: var(--paper); text-decoration: none; box-shadow: var(--shadow-sm); }
  .featured-accent { display: grid; place-items: center; color: var(--category-color); background: var(--category-soft); }
  .featured-copy { align-self: center; min-width: 0; padding: 19px 22px; }
  .content-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .featured-copy h3 { margin: 8px 0 6px; font-size: clamp(1.12rem, 2vw, 1.48rem); line-height: 1.34; }
  .featured-copy p { display: -webkit-box; margin: 0 0 9px; overflow: hidden; color: var(--muted-strong); font-size: 0.83rem; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .featured-copy small { display: block; overflow: hidden; color: var(--muted); font-size: 0.7rem; text-overflow: ellipsis; white-space: nowrap; }
  .featured-arrow { align-self: center; color: var(--category-color); }

  .content-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .content-list li { min-width: 0; }
  .content-row { min-width: 0; min-height: 112px; height: 100%; display: grid; grid-template-columns: 4px minmax(0, 1fr) 18px; align-items: center; gap: 12px; padding: 13px 13px 13px 0; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); text-decoration: none; }
  .content-row:hover { border-color: color-mix(in srgb, var(--category-color) 38%, var(--line)); background: var(--surface); }
  .row-marker { align-self: stretch; border-radius: 0 3px 3px 0; background: var(--category-color); }
  .row-copy { min-width: 0; display: grid; gap: 4px; }
  .row-meta { min-width: 0; display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 0.65rem; }
  .row-meta strong { color: var(--category-color); }
  .row-meta b { padding: 1px 4px; border-radius: 3px; color: var(--category-color); background: var(--category-soft); }
  .row-meta time { margin-left: auto; white-space: nowrap; }
  .row-title { display: -webkit-box; overflow: hidden; font-size: 0.88rem; font-weight: 800; line-height: 1.38; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .row-summary { overflow: hidden; color: var(--muted); font-size: 0.72rem; text-overflow: ellipsis; white-space: nowrap; }
  .content-row > svg { color: var(--muted); }

  .home-rail { position: sticky; top: 84px; display: grid; gap: 16px; }
  .quick-panel, .explore-panel { padding: 17px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--paper); }
  .quick-links { display: grid; gap: 5px; }
  .quick-link { min-height: 56px; display: grid; grid-template-columns: 24px minmax(0, 1fr) 18px; align-items: center; gap: 9px; padding: 7px 10px; border-radius: var(--radius-sm); color: var(--ink); background: var(--surface); text-decoration: none; }
  .quick-link:hover { background: var(--surface-strong); }
  .quick-link.primary { color: var(--contrast-ink); background: var(--contrast-surface); }
  .quick-link > span { min-width: 0; display: grid; }
  .quick-link strong { font-size: 0.8rem; }
  .quick-link small { color: var(--muted); font-size: 0.66rem; }
  .quick-link.primary small { color: var(--contrast-muted); }

  .explore-list { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .explore-list a { min-width: 0; display: grid; grid-template-columns: 32px minmax(0, 1fr); align-items: center; gap: 9px; padding: 8px 4px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .explore-list li:first-child a { border-top: 0; }
  .explore-icon { width: 32px; height: 32px; display: grid; place-items: center; border-radius: var(--radius-sm); color: var(--category-color); background: var(--category-soft); }
  .explore-list a > span:last-child { min-width: 0; display: grid; gap: 1px; }
  .explore-list small { color: var(--muted); font-size: 0.64rem; }
  .explore-list strong { display: -webkit-box; overflow: hidden; font-size: 0.76rem; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

  .archive-panel { display: grid; grid-template-columns: 34px minmax(0, 1fr) 18px; align-items: center; gap: 10px; padding: 15px 16px; border-radius: var(--radius-md); color: var(--contrast-ink); background: var(--contrast-surface); text-decoration: none; }
  .archive-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--radius-sm); color: var(--contrast-accent); background: var(--contrast-line); }
  .archive-panel > span:nth-child(2) { min-width: 0; display: grid; }
  .archive-panel small { color: var(--contrast-muted); font-size: 0.66rem; }
  .archive-panel strong { font-size: 0.82rem; }
  .archive-days { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 5px 10px; padding-top: 9px; border-top: 1px solid var(--contrast-line); }
  .archive-days i { display: inline-flex; align-items: center; gap: 4px; color: var(--contrast-muted); font-size: 0.62rem; font-style: normal; }
  .empty-state { display: grid; justify-items: center; padding: 58px 20px; border: 1px dashed var(--line); border-radius: var(--radius-md); background: var(--paper); text-align: center; }
  .empty-state h2 { margin: 13px 0 18px; font-size: 1.05rem; }

  @media (max-width: 1080px) {
    .topic-strip { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .home-dashboard { grid-template-columns: minmax(0, 1fr) 280px; }
    .content-list { grid-template-columns: 1fr; }
  }

  @media (max-width: 900px) {
    .home-dashboard { grid-template-columns: 1fr; }
    .home-rail { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .archive-panel { align-self: start; }
  }

  @media (max-width: 620px) {
    .hero, .hero-content { min-height: 238px; }
    .hero-image { background-image: linear-gradient(90deg, color-mix(in srgb, var(--paper) 92%, transparent), color-mix(in srgb, var(--paper) 54%, transparent)), url("/images/life-quiz-desk.webp"); background-position: 60% center; }
    .hero h1 { font-size: 1.85rem; }
    .hero-content > p { max-width: 270px; font-size: 0.82rem; }
    .hero-actions { width: 100%; display: grid; grid-template-columns: 1fr auto auto; }
    .hero-actions .button { padding-inline: 12px; }
    .hero-link { width: 39px; padding: 0; justify-content: center; font-size: 0; }
    .hero-link svg { width: 18px; height: 18px; }
    .home-page { padding-top: 20px; }
    .category-section { margin-bottom: 22px; }
    .topic-strip { display: flex; gap: 7px; padding-bottom: 6px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
    .topic-strip::-webkit-scrollbar { display: none; }
    .topic-link { min-width: 118px; flex: 0 0 118px; scroll-snap-align: start; }
    .topic-link.all { min-width: 84px; flex-basis: 84px; }
    .featured-story { min-height: 148px; grid-template-columns: 42px minmax(0, 1fr) 30px; }
    .featured-copy { padding: 16px 13px; }
    .featured-copy h3 { font-size: 1.02rem; }
    .featured-copy p { -webkit-line-clamp: 1; }
    .content-list { grid-template-columns: 1fr; }
    .content-row { min-height: 100px; }
    .row-summary { display: none; }
    .home-rail { grid-template-columns: 1fr; }
  }
</style>
