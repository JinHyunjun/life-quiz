---
export const prerender = false;

import { env } from "cloudflare:workers";
import { ArrowLeft, BookOpen, ChevronLeft, ChevronRight, Network, PanelsTopLeft } from "lucide-astro";
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db/client";
import { CATEGORY_LABELS, categoryLabel, type Category } from "../../lib/categories";
import { normalizeKeywordQuery } from "../../lib/content-keywords";
import { listContentItemsByKeyword, type OriginType } from "../../lib/content";
import { formatShortDate } from "../../lib/dates";
import { excerpt } from "../../lib/text";

const SOURCE_LABELS: Record<OriginType, string> = {
  gov: "공공데이터",
  news: "뉴스·RSS",
  youtube: "YouTube",
  ai_trivia: "AI 상식",
};

const rawKeyword = Astro.params.keyword;
let decodedKeyword = rawKeyword;
try {
  decodedKeyword = rawKeyword ? decodeURIComponent(rawKeyword) : undefined;
} catch {}
const keyword = normalizeKeywordQuery(decodedKeyword);
if (!keyword) return Astro.redirect("/topics");

const categoryParam = Astro.url.searchParams.get("category");
const activeCategory = (categoryParam && categoryParam in CATEGORY_LABELS ? categoryParam : undefined) as Category | undefined;
const pageParam = Number(Astro.url.searchParams.get("page") ?? 1);
const db = createDb(env.DB);
const results = await listContentItemsByKeyword(db, { keyword, category: activeCategory, page: pageParam });
const keywordPath = `/topics/${encodeURIComponent(keyword)}`;
const availableCategories = results.categoryCounts.filter((item) => item.count > 0);

function resultHref(overrides: { category?: string | null; page?: number | null }) {
  const next = new URLSearchParams();
  const category = overrides.category === undefined ? activeCategory : overrides.category;
  if (category) next.set("category", category);
  const page = overrides.page ?? 1;
  if (page > 1) next.set("page", String(page));
  const query = next.toString();
  return query ? `${keywordPath}?${query}` : keywordPath;
}

Astro.response.headers.set("cache-control", "public, max-age=180, stale-while-revalidate=900");
---

<Base title={`${keyword} 지식 모아보기`} description={`${keyword} 키워드가 포함된 라이프퀴즈 콘텐츠를 한곳에서 살펴봅니다.`}>
  <div class="topic-results-page shell">
    <a class="back-link" href="/topics"><ArrowLeft size={16} /> 지식 지도</a>

    <header class="results-header" data-category={activeCategory}>
      <div>
        <p class="eyebrow">CONNECTED CONTENT</p>
        <h1 class="page-title"><span>“{keyword}”</span>이 담긴 상식</h1>
        <p>{activeCategory ? `${categoryLabel(activeCategory)}에서 ` : ""}{results.total.toLocaleString("ko-KR")}개의 콘텐츠가 연결되어 있습니다.</p>
      </div>
      <div class="result-total" aria-label={`검색 결과 ${results.total}개`}>
        <Network size={21} />
        <strong>{results.total}</strong>
        <span>CONTENTS</span>
      </div>
    </header>

    <nav class="category-tabs" aria-label="연결된 콘텐츠 분야">
      <a class:list={["category-tab", { active: !activeCategory }]} href={resultHref({ category: null, page: 1 })} aria-current={!activeCategory ? "page" : undefined}>
        <span>전체</span><strong>{results.categoryCounts.reduce((sum, item) => sum + item.count, 0)}</strong>
      </a>
      {availableCategories.map((item) => (
        <a
          class:list={["category-tab", { active: activeCategory === item.category }]}
          href={resultHref({ category: item.category, page: 1 })}
          data-category={item.category}
          aria-current={activeCategory === item.category ? "page" : undefined}
        >
          <span class="category-swatch"></span><span>{categoryLabel(item.category)}</span><strong>{item.count}</strong>
        </a>
      ))}
    </nav>

    <section class="results-section" aria-labelledby="result-list-title">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">ARTICLES</p>
          <h2 id="result-list-title">연결된 콘텐츠</h2>
        </div>
        <span>{results.page} / {results.totalPages} 페이지</span>
      </div>

      {results.items.length > 0 ? (
        <ul class="result-grid">
          {results.items.map((item) => (
            <li>
              <a class="result-card" href={`/articles/${item.id}`}>
                <div class="card-topline">
                  <div class="card-tags">
                    <span class="category-label" data-category={item.category}>{categoryLabel(item.category)}</span>
                    {item.contentFormat === "visual_guide" && <span class="visual-format-badge"><PanelsTopLeft size={13} /> 4컷 설명</span>}
                  </div>
                  <span class="source-type">{item.originType ? SOURCE_LABELS[item.originType] : "기타"}</span>
                </div>
                <h3>{item.title}</h3>
                <p>{item.cards?.[0]?.body ?? excerpt(item.bodyMd)}</p>
                <div class="card-footer">
                  <span>{item.citationLabel}</span>
                  <span>{formatShortDate(item.createdAt)}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="results-empty">
          <BookOpen size={30} />
          <h3>이 분야에는 연결된 콘텐츠가 없습니다.</h3>
          <a class="button button-secondary" href={keywordPath}>전체 결과 보기</a>
        </div>
      )}

      {results.totalPages > 1 && (
        <nav class="pagination" aria-label="키워드 콘텐츠 페이지">
          {results.page > 1 ? (
            <a class="button button-secondary" href={resultHref({ page: results.page - 1 })}><ChevronLeft size={17} /> 이전</a>
          ) : <span class="button button-secondary disabled"><ChevronLeft size={17} /> 이전</span>}
          <span class="page-status"><strong>{results.page}</strong><span>/</span>{results.totalPages}</span>
          {results.page < results.totalPages ? (
            <a class="button button-secondary" href={resultHref({ page: results.page + 1 })}>다음 <ChevronRight size={17} /></a>
          ) : <span class="button button-secondary disabled">다음 <ChevronRight size={17} /></span>}
        </nav>
      )}
    </section>
  </div>
</Base>

<style>
  .topic-results-page { padding-top: 34px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; color: var(--muted); font-size: 0.76rem; font-weight: 800; text-decoration: none; }
  .back-link:hover { color: var(--green-deep); }

  .results-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 30px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }
  .results-header .page-title span { color: var(--category-color, var(--green-deep)); }
  .results-header p:not(.eyebrow) { margin: 10px 0 0; color: var(--muted); }
  .result-total { min-width: 138px; display: grid; grid-template-columns: auto auto; align-items: center; justify-content: end; gap: 2px 8px; color: var(--green); }
  .result-total strong { color: var(--ink); font-size: 2rem; line-height: 1; }
  .result-total span { grid-column: 1 / -1; color: var(--muted); font-size: 0.62rem; font-weight: 850; text-align: right; }

  .category-tabs {
    display: flex;
    gap: 0 22px;
    overflow-x: auto;
    padding: 0;
    border-bottom: 1px solid var(--line);
    scrollbar-width: thin;
  }
  .category-tab { min-height: 52px; display: inline-flex; align-items: center; gap: 7px; flex: 0 0 auto; border-bottom: 2px solid transparent; color: var(--muted); font-size: 0.74rem; font-weight: 800; text-decoration: none; }
  .category-tab strong { font-size: 0.66rem; font-variant-numeric: tabular-nums; }
  .category-tab .category-swatch { width: 7px; height: 7px; border-radius: 50%; background: var(--category-color); }
  .category-tab:hover { color: var(--ink); }
  .category-tab.active { border-color: var(--category-color, var(--green)); color: var(--category-color, var(--green-deep)); }

  .results-section { padding: 36px 0 72px; }
  .compact-heading { margin-bottom: 18px; }
  .compact-heading > span { color: var(--muted); font-size: 0.72rem; font-weight: 800; }
  .result-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .result-grid li { min-width: 0; }
  .result-card { min-height: 245px; display: flex; flex-direction: column; gap: 13px; padding: 20px; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); background: var(--surface); text-decoration: none; transition: border-color 150ms ease, transform 150ms ease; }
  .result-card:hover { border-color: color-mix(in srgb, var(--green) 38%, var(--line)); transform: translateY(-2px); }
  .card-topline, .card-tags, .card-footer { display: flex; align-items: center; }
  .card-topline { justify-content: space-between; gap: 10px; }
  .card-tags { min-width: 0; gap: 6px; }
  .source-type { color: var(--muted); font-size: 0.64rem; font-weight: 800; white-space: nowrap; }
  .visual-format-badge { display: inline-flex; align-items: center; gap: 4px; color: var(--muted); font-size: 0.62rem; font-weight: 800; white-space: nowrap; }
  .result-card h3 { display: -webkit-box; overflow: hidden; margin: 0; font-size: 1rem; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .result-card > p { display: -webkit-box; overflow: hidden; margin: 0; color: var(--muted); font-size: 0.78rem; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .card-footer { min-width: 0; justify-content: space-between; gap: 10px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.64rem; }
  .card-footer span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card-footer span:last-child { flex: 0 0 auto; white-space: nowrap; }

  .results-empty { min-height: 300px; display: grid; place-content: center; justify-items: center; color: var(--muted); text-align: center; }
  .results-empty h3 { margin: 12px 0 18px; color: var(--ink); font-size: 1rem; }
  .pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; margin-top: 28px; }
  .pagination > :last-child { justify-self: end; }
  .pagination .disabled { opacity: 0.45; pointer-events: none; }
  .page-status { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.76rem; }
  .page-status strong { color: var(--ink); }

  @media (max-width: 1020px) {
    .result-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .topic-results-page { padding-top: 24px; }
    .results-header { grid-template-columns: 1fr; align-items: start; gap: 20px; }
    .result-total { justify-content: start; }
    .result-total span { text-align: left; }
    .category-tabs { margin-inline: calc(var(--shell-pad) * -1); padding-inline: var(--shell-pad); }
    .result-grid { grid-template-columns: 1fr; }
    .result-card { min-height: 0; }
    .pagination { grid-template-columns: 1fr auto 1fr; }
    .pagination .button { min-width: 0; padding-inline: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .result-card { transition: none; }
  }
</style>
