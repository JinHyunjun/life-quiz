---
export const prerender = false;

import { env } from "cloudflare:workers";
import { ArrowLeft, Mail } from "lucide-astro";
import Base from "../layouts/Base.astro";
import { createLifeQuizEmailSender } from "../lib/email";

const emailDeliveryEnabled = Boolean(createLifeQuizEmailSender(env));
---

<Base title="비밀번호 재설정" description="라이프퀴즈 계정의 비밀번호 재설정 링크를 요청합니다.">
  <main class="recovery-page shell">
    <a class="back-link" href="/login"><ArrowLeft size={16} /> 로그인으로 돌아가기</a>
    <header><p class="eyebrow">ACCOUNT RECOVERY</p><h1 class="page-title">비밀번호를 다시 설정하세요</h1><p>가입한 이메일로 1시간 동안 사용할 수 있는 재설정 링크를 보냅니다.</p></header>
    <form id="forgot-password-form">
      <label>가입 이메일<input type="email" name="email" autocomplete="email" required disabled={!emailDeliveryEnabled} /></label>
      <button class="button button-primary" type="submit" disabled={!emailDeliveryEnabled}><Mail size={17} /> 재설정 링크 받기</button>
      <p class="form-status" aria-live="polite" data-form-status>{emailDeliveryEnabled ? "" : "현재 발신 도메인 연결을 준비 중입니다. 아래 비공개 문의 창구를 이용해주세요."}</p>
    </form>
    <p class="support-note">메일을 받을 수 없거나 계정 이메일을 기억하지 못한다면 <a href="/support?category=account_access">문의·피드백</a>으로 접수해주세요. 비밀번호나 인증번호는 문의에 입력하지 마세요.</p>
  </main>
</Base>

<script>
  import { authClient } from "../lib/auth-client";

  document.querySelector<HTMLFormElement>("#forgot-password-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const email = String(new FormData(form).get("email") ?? "").trim();
    if (submit) submit.disabled = true;
    if (status) status.textContent = "재설정 링크를 준비하고 있습니다.";
    const result = await authClient.requestPasswordReset({ email, redirectTo: "/reset-password" });
    if (result.error) {
      if (status) status.textContent = result.error.code === "RESET_PASSWORD_DISABLED"
        ? "현재 메일 전송을 준비 중입니다. 문의·피드백으로 접수해주세요."
        : "요청을 처리하지 못했습니다. 잠시 뒤 다시 시도해주세요.";
      if (submit) submit.disabled = false;
      return;
    }
    form.reset();
    if (status) status.textContent = "가입된 이메일이라면 재설정 링크가 도착합니다. 메일함을 확인해주세요.";
  });
</script>

<style>
  .recovery-page { max-width: 620px; padding-top: 72px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 28px; color: var(--muted-strong); font-size: 0.76rem; font-weight: 750; text-decoration: none; }
  header > p:last-child { margin: 10px 0 0; color: var(--muted); }
  form { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 10px; margin-top: 30px; padding-block: 22px; border-block: 1px solid var(--line); }
  label { display: grid; gap: 6px; color: var(--muted-strong); font-size: 0.74rem; font-weight: 750; }
  input { min-height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); background: var(--surface); }
  .form-status { grid-column: 1 / -1; min-height: 20px; margin: 0; color: var(--muted-strong); font-size: 0.72rem; }
  button:disabled, input:disabled { opacity: 0.58; }
  .support-note { color: var(--muted); font-size: 0.72rem; }
  .support-note a { color: var(--green-deep); font-weight: 750; }
  @media (max-width: 620px) { .recovery-page { padding-top: 38px; } form { grid-template-columns: 1fr; } form .button { width: 100%; } }
</style>
