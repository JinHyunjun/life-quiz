---
export const prerender = false;

import { env } from "cloudflare:workers";
import { Activity, AlertTriangle, Bookmark, Bot, CalendarCheck2, CalendarClock, Check, CheckCircle2, CircleX, Clock3, Database, EyeOff, FileCheck2, Gauge, KeyRound, ListChecks, LogOut, Mail, MessageSquareWarning, MousePointerClick, Play, Radio, RefreshCw, Repeat2, SlidersHorizontal, ThumbsUp, UserCheck, UsersRound } from "lucide-astro";
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db/client";
import { isAuthorizedAdminSession } from "../../lib/admin";
import { CATEGORY_LABELS } from "../../lib/categories";
import { formatKstDate } from "../../lib/dates";
import { FEEDBACK_LABELS } from "../../lib/feedback";
import { getQualityDashboard, type QualityStatus } from "../../lib/quality";
import { listSupportInbox, SUPPORT_CATEGORY_LABELS } from "../../lib/support";

if (!(await isAuthorizedAdminSession(Astro.request, env.INGEST_ADMIN_TOKEN))) {
  return Astro.redirect(`/admin/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}

Astro.response.headers.set("cache-control", "no-store");
const db = createDb(env.DB);
const [dashboard, supportInbox] = await Promise.all([
  getQualityDashboard(db, new Date(), Number(env.GEMINI_DAILY_BUDGET)),
  listSupportInbox(db),
]);
const maxDailyCount = Math.max(1, ...dashboard.daily.map(({ count }) => count));
const maxGeminiDailyCount = Math.max(1, ...dashboard.operations.gemini.daily.map(({ count }) => count));
const diagnosticSummary = dashboard.latestDiagnostics.reduce(
  (summary, diagnostic) => ({ ...summary, [diagnostic.status]: summary[diagnostic.status] + 1 }),
  { success: 0, empty: 0, error: 0 },
);
const collectorHealthStatus = dashboard.checks.find(({ key }) => key === "collector-health")?.status ?? "fail";
const sourceLabels = { gov: "공공데이터", news: "뉴스·RSS", youtube: "YouTube", ai_trivia: "AI 큐레이션" };
const collectorFamilyLabels = {
  rss: "뉴스·정책 RSS",
  youtube: "YouTube",
  public_data: "공공데이터",
  curriculum: "출처형 커리큘럼",
  other: "기타",
};
const overallCopy = {
  pass: { label: "정상", detail: "핵심 품질 기준을 모두 충족하고 있습니다." },
  warning: { label: "점검 필요", detail: "서비스는 동작 중이며 일부 지표를 확인해야 합니다." },
  fail: { label: "조치 필요", detail: "발행 또는 수집 파이프라인에 즉시 확인할 항목이 있습니다." },
}[dashboard.overallStatus];

const dateTimeFormatter = new Intl.DateTimeFormat("ko-KR", {
  timeZone: "Asia/Seoul",
  month: "short",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});

function statusLabel(status: QualityStatus) {
  return status === "pass" ? "정상" : status === "warning" ? "주의" : "실패";
}
---

<Base title="운영 품질 대시보드" description="라이프퀴즈 콘텐츠와 수집 파이프라인 품질 현황">
  <div class="admin-page shell">
    <header class="admin-header">
      <div>
        <p class="eyebrow">OPERATIONS</p>
        <h1 class="page-title">품질 검증 대시보드</h1>
        <p>콘텐츠 품질은 접속 시 최신 D1 기준으로 계산하고, 수집 결과는 기존 6시간 Cron 실행마다 기록합니다.</p>
      </div>
      <form method="post" action="/api/admin/logout">
        <button class="button button-secondary" type="submit"><LogOut size={17} /> 로그아웃</button>
      </form>
    </header>

    <section class="quality-status" data-status={dashboard.overallStatus} aria-labelledby="overall-title">
      <span class="status-symbol" aria-hidden="true">
        {dashboard.overallStatus === "pass" ? <CheckCircle2 size={25} /> : dashboard.overallStatus === "warning" ? <AlertTriangle size={25} /> : <CircleX size={25} />}
      </span>
      <div>
        <p class="eyebrow">OVERALL STATUS</p>
        <h2 id="overall-title">{overallCopy.label}</h2>
        <p>{overallCopy.detail}</p>
      </div>
      <time datetime={dashboard.checkedAt.toISOString()}>검증 {dateTimeFormatter.format(dashboard.checkedAt)}</time>
    </section>

    <section class="check-section" aria-labelledby="checks-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">QUALITY CHECKS</p>
          <h2 id="checks-title">핵심 품질 기준</h2>
        </div>
        <span class="section-note"><RefreshCw size={14} /> 대시보드 접속 시 갱신</span>
      </div>
      <ul class="check-grid">
        {dashboard.checks.map((check) => (
          <li class="check-card" data-status={check.status}>
            <div class="check-topline">
              <span class="check-icon" aria-hidden="true">
                {check.status === "pass" ? <CheckCircle2 size={18} /> : check.status === "warning" ? <AlertTriangle size={18} /> : <CircleX size={18} />}
              </span>
              <span class="status-badge">{statusLabel(check.status)}</span>
            </div>
            <span>{check.label}</span>
            <strong>{check.value}</strong>
            <small>{check.detail}</small>
          </li>
        ))}
      </ul>
    </section>

    <section class="activation-section" aria-labelledby="activation-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ACTIVATION FUNNEL</p>
          <h2 id="activation-title">방문에서 학습 완료까지</h2>
        </div>
        <span class="section-note"><MousePointerClick size={14} /> 익명 브라우저 기준 · 매일 갱신</span>
      </div>
      <div class="activation-periods">
        {dashboard.activation.map((period) => (
          <article class="activation-period">
            <header>
              <div><strong>최근 {period.days}일</strong><span>고유 브라우저 전환</span></div>
              <span class="return-rate"><Repeat2 size={14} /> 재방문 {period.returnRate}%</span>
            </header>
            <ol class="funnel-steps">
              <li>
                <span><MousePointerClick size={16} /> 방문</span>
                <strong>{period.visitors}</strong>
                <small>기준 100%</small>
              </li>
              <li>
                <span><Play size={16} /> 학습 시작</span>
                <strong>{period.dailyStarts}</strong>
                <small>방문 대비 {period.startRate}%</small>
              </li>
              <li>
                <span><ListChecks size={16} /> 첫 답변</span>
                <strong>{period.firstAnswers}</strong>
                <small>시작 대비 {period.answerRate}%</small>
              </li>
              <li>
                <span><CalendarCheck2 size={16} /> 학습 완료</span>
                <strong>{period.completions}</strong>
                <small>시작 대비 {period.completionRate}%</small>
              </li>
            </ol>
            <footer>
              <span><SlidersHorizontal size={14} /> 관심사 저장 <strong>{period.preferenceSaves}</strong></span>
              <span><UserCheck size={14} /> 계정 생성 <strong>{period.accountCreations}</strong></span>
              <span><KeyRound size={14} /> 로그인 <strong>{period.accountSignIns}</strong></span>
              <span><Repeat2 size={14} /> 기록 연결 <strong>{period.anonymousLinks}</strong></span>
              <span><Repeat2 size={14} /> 다른 날 재방문 <strong>{period.returningVisitors}</strong></span>
            </footer>
          </article>
        ))}
      </div>
      <p class="activation-note">배포 이후 수집한 최소 행동만 집계하며 질문 내용, 답변 내용, 이메일은 저장하지 않습니다.</p>
    </section>

    <section class="operations-section" aria-labelledby="operations-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">AI &amp; SOURCE OPERATIONS</p>
          <h2 id="operations-title">AI 예산과 수집원 안정성</h2>
        </div>
        <span class="section-note"><Activity size={14} /> KST 기준 자동 집계</span>
      </div>

      <div class="operations-grid">
        <div class="ai-operations">
          <div class="operation-heading">
            <span class="operation-icon" data-status={dashboard.operations.gemini.status}><Bot size={18} /></span>
            <div>
              <h3>Gemini 일일 요청 예산</h3>
              <p>콘텐츠 생성과 라이프 메이트 호출을 한 예산으로 관리합니다.</p>
            </div>
          </div>
          <div class="budget-summary">
            <div>
              <strong>{dashboard.operations.gemini.used}<small> / {dashboard.operations.gemini.budget}회</small></strong>
              <span>오늘 사용량</span>
            </div>
            <div>
              <strong>{dashboard.operations.gemini.remaining}<small>회</small></strong>
              <span>남은 요청</span>
            </div>
            <div>
              <strong>{dashboard.operations.gemini.percentage}<small>%</small></strong>
              <span>예산 소진율</span>
            </div>
          </div>
          <div class="budget-progress" data-status={dashboard.operations.gemini.status}>
            <progress max={dashboard.operations.gemini.budget} value={dashboard.operations.gemini.used} aria-label={`Gemini 일일 예산 ${dashboard.operations.gemini.percentage}% 사용`}></progress>
            <div class="purpose-split">
              <span><Gauge size={14} /> 콘텐츠 생성 <strong>{dashboard.operations.gemini.ingestion}회</strong></span>
              <span><MessageSquareWarning size={14} /> 라이프 메이트 <strong>{dashboard.operations.gemini.chat}회</strong></span>
            </div>
          </div>
          <div class="ai-daily-chart" role="img" aria-label="최근 14일 Gemini 요청량">
            {dashboard.operations.gemini.daily.map(({ day, count }) => (
              <div class="ai-daily-column" title={`${formatKstDate(day)} ${count}회`}>
                <strong>{count}</strong>
                <span class="bar-track"><span class="bar-fill" style={`height: ${Math.max(4, Math.round((count / maxGeminiDailyCount) * 100))}%`}></span></span>
                <small>{day.slice(5).replace("-", "/")}</small>
              </div>
            ))}
          </div>
          <p class="operation-note">요청 기록은 14일간 보관합니다. 이 기능 도입 전 날짜는 기존 24시간 보관 정책 때문에 0으로 표시될 수 있습니다.</p>
        </div>

        <div class="collector-operations">
          <div class="operation-heading">
            <span class="operation-icon" data-status={collectorHealthStatus}><Radio size={18} /></span>
            <div>
              <h3>최근 {dashboard.operations.collectorWindowDays}일 수집원 건강 상태</h3>
              <p>후보 수, 빈 응답, 오류 비율을 경로별로 합산합니다.</p>
            </div>
          </div>
          {dashboard.operations.collectorHealth.length > 0 ? (
            <div class="table-scroll health-table">
              <table>
                <thead>
                  <tr><th>수집 경로</th><th>검사</th><th>후보</th><th>성공</th><th>빈 응답</th><th>오류</th><th>오류율</th><th>상태</th></tr>
                </thead>
                <tbody>
                  {dashboard.operations.collectorHealth.map((health) => (
                    <tr>
                      <td><strong>{collectorFamilyLabels[health.family]}</strong></td>
                      <td>{health.checks}</td>
                      <td>{health.candidates}</td>
                      <td>{health.success}</td>
                      <td>{health.empty}</td>
                      <td class:list={{ danger: health.error > 0 }}>{health.error}</td>
                      <td>{health.errorRate}%</td>
                      <td><span class="table-status" data-status={health.status}>{statusLabel(health.status)}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty-diagnostics"><Database size={24} /><span>최근 7일 수집원 진단 기록이 없습니다.</span></div>
          )}
        </div>
      </div>
    </section>

    <div class="admin-columns">
      <section class="admin-section" aria-labelledby="daily-title">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">PUBLISHING TREND</p>
            <h2 id="daily-title">최근 14일 발행량</h2>
          </div>
          <span class="metric-inline"><FileCheck2 size={15} /> 누적 {dashboard.content.total}개</span>
        </div>
        <div class="daily-chart" role="img" aria-label={`최근 14일 일별 발행량. 오늘 ${dashboard.todayCount}개`}>
          {dashboard.daily.map(({ day, count }) => (
            <div class="daily-column" title={`${formatKstDate(day)} ${count}개`}>
              <strong>{count}</strong>
              <span class="bar-track"><span class="bar-fill" style={`height: ${Math.max(4, Math.round((count / maxDailyCount) * 100))}%`}></span></span>
              <small>{day.slice(5).replace("-", "/")}</small>
            </div>
          ))}
        </div>
      </section>

      <section class="admin-section" aria-labelledby="coverage-title">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">COVERAGE</p>
            <h2 id="coverage-title">오늘 주제·전체 출처</h2>
          </div>
        </div>
        <div class="coverage-split">
          <div>
            <h3>오늘 분야 · 최소/상한</h3>
            <ul class="distribution-list">
              {dashboard.publishingTargets.map(({ category, count, minimum, maximum, status }) => (
                <li data-target-status={status}>
                  <span><span class="category-swatch" data-category={category}></span>{CATEGORY_LABELS[category]} <small>{minimum}–{maximum}</small></span>
                  <strong>{count}</strong>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3>전체 출처</h3>
            <ul class="distribution-list">
              {dashboard.sourceRows.map(({ originType, count }) => (
                <li><span>{originType ? sourceLabels[originType] : "출처 미분류"}</span><strong>{count}</strong></li>
              ))}
              <li><span>검수로 숨김</span><strong>{dashboard.hiddenCount}</strong></li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <section class="admin-section support-inbox-section" aria-labelledby="support-inbox-title">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">PRIVATE SUPPORT</p>
          <h2 id="support-inbox-title">문의함</h2>
        </div>
        <div class="feedback-metrics">
          <span><Mail size={14} /> 새 문의 <strong id="open-support-count">{supportInbox.openCount}</strong></span>
          <span><Clock3 size={14} /> 처리 중 {supportInbox.activeCount - supportInbox.openCount}</span>
        </div>
      </div>
      {supportInbox.queue.length > 0 ? (
        <ul class="support-inbox" id="support-inbox">
          {supportInbox.queue.map((request) => (
            <li data-support-row={request.id} data-status={request.status}>
              <div class="support-ticket-topline">
                <span class="support-ticket-code">LQ-{String(request.id).padStart(6, "0")}</span>
                <span class="table-status" data-status={request.status === "open" ? "fail" : "warning"}>{request.status === "open" ? "새 문의" : "처리 중"}</span>
              </div>
              <div class="support-ticket-content">
                <span>{SUPPORT_CATEGORY_LABELS[request.category]} · {dateTimeFormatter.format(request.createdAt)}</span>
                <h3>{request.subject}</h3>
                <p>{request.message}</p>
                <small>{request.name} · <a href={`mailto:${request.email}`}>{request.email}</a>{request.userId ? " · 로그인 계정" : " · 비로그인"}</small>
              </div>
              <div class="support-ticket-actions">
                <a class="icon-button" href={`mailto:${request.email}?subject=${encodeURIComponent(`[Life Quiz ${`LQ-${String(request.id).padStart(6, "0")}`}] ${request.subject}`)}`} aria-label="이메일로 답변" title="이메일로 답변"><Mail size={17} /></a>
                {request.status === "open" && <button class="icon-button" type="button" data-support-id={request.id} data-support-action="in_progress" aria-label="문의 처리 시작" title="처리 시작"><Clock3 size={17} /></button>}
                <button class="icon-button" type="button" data-support-id={request.id} data-support-action="resolved" aria-label="문의 해결 완료" title="해결 완료"><Check size={17} /></button>
                <button class="icon-button" type="button" data-support-id={request.id} data-support-action="dismissed" aria-label="문의 종료" title="종료"><EyeOff size={17} /></button>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-diagnostics" id="support-empty"><CheckCircle2 size={24} /><span>확인할 비공개 문의가 없습니다.</span></div>
      )}
      <p class="admin-action-status" id="support-action-status" aria-live="polite"></p>
    </section>

    <section class="admin-section feedback-queue-section" aria-labelledby="feedback-queue-title">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">USER FEEDBACK</p>
          <h2 id="feedback-queue-title">콘텐츠 QA 큐</h2>
        </div>
        <div class="feedback-metrics">
          <span><MessageSquareWarning size={14} /> 열린 제보 <strong id="open-feedback-count">{dashboard.feedback.openCount}</strong></span>
          <span><ThumbsUp size={14} /> 도움됨 {dashboard.feedback.helpfulCount}</span>
        </div>
      </div>
      {dashboard.feedback.queue.length > 0 ? (
        <ul class="feedback-queue" id="feedback-queue">
          {dashboard.feedback.queue.map((feedback) => (
            <li data-feedback-row={feedback.id}>
              <span class="category-swatch" data-category={feedback.category}></span>
              <div class="feedback-content">
                <a href={`/articles/${feedback.contentItemId}`} target="_blank" rel="noopener noreferrer">{feedback.title}</a>
                <span><strong>{FEEDBACK_LABELS[feedback.kind]}</strong> · {feedback.citationLabel} · {dateTimeFormatter.format(feedback.createdAt)}</span>
              </div>
              <div class="feedback-actions">
                <button class="icon-button" type="button" data-feedback-id={feedback.id} data-feedback-action="resolved" aria-label="제보 해결 처리" title="해결 처리">
                  <Check size={17} />
                </button>
                <button class="icon-button" type="button" data-feedback-id={feedback.id} data-feedback-action="dismissed" aria-label="제보 보류 처리" title="보류 처리">
                  <EyeOff size={17} />
                </button>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-diagnostics" id="feedback-empty"><CheckCircle2 size={24} /><span>처리할 사용자 제보가 없습니다.</span></div>
      )}
      <p class="admin-action-status" id="admin-action-status" aria-live="polite"></p>
    </section>

    <section class="admin-section adoption-section" aria-labelledby="adoption-title">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">LEARNING ADOPTION</p>
          <h2 id="adoption-title">개인화·학습 사용 현황</h2>
        </div>
      </div>
      <dl class="adoption-metrics">
        <div>
          <dt><UserCheck size={17} /> 등록 계정</dt>
          <dd>{dashboard.engagement.registeredAccounts}<small>명</small></dd>
        </div>
        <div>
          <dt><KeyRound size={17} /> 유효 로그인</dt>
          <dd>{dashboard.engagement.activeAccountSessions}<small>명</small></dd>
        </div>
        <div>
          <dt><UsersRound size={17} /> 관심 분야 설정</dt>
          <dd>{dashboard.engagement.preferenceUsers}<small>브라우저</small></dd>
        </div>
        <div>
          <dt><Bookmark size={17} /> 저장한 상식</dt>
          <dd>{dashboard.engagement.savedItems}<small>건</small></dd>
        </div>
        <div>
          <dt><CalendarCheck2 size={17} /> 완료한 5분 학습</dt>
          <dd>{dashboard.engagement.completedDailySessions}<small>세션</small></dd>
        </div>
      </dl>
    </section>

    <section class="admin-section" aria-labelledby="runs-title">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">INGESTION HISTORY</p>
          <h2 id="runs-title">수집·검증 실행 이력</h2>
        </div>
        <div class="run-actions">
          <span class="section-note"><CalendarClock size={14} /> KST 00·06·12·18시</span>
          <button class="button button-secondary run-ingestion-button" id="run-ingestion" type="button">
            <RefreshCw size={16} /> 지금 수집·검증
          </button>
        </div>
      </div>
      <p class="ingestion-action-status" id="ingestion-action-status" aria-live="polite"></p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>실행 시각</th><th>방식</th><th>상태</th><th>후보</th><th>생성</th><th>중복·제외</th><th>지연</th><th>실패</th></tr>
          </thead>
          <tbody>
            {dashboard.runs.map((run) => (
              <tr>
                <td><time datetime={run.startedAt.toISOString()}>{dateTimeFormatter.format(run.startedAt)}</time></td>
                <td>{run.trigger === "scheduled" ? "자동" : "수동"}</td>
                <td><span class="table-status" data-status={run.status === "success" ? "pass" : "fail"}>{run.status === "success" ? "완료" : "오류"}</span></td>
                <td>{run.pendingCount}</td>
                <td><strong>{run.createdCount}</strong></td>
                <td>{run.skippedCount}</td>
                <td>{run.deferredCount}</td>
                <td class:list={{ danger: run.failedCount > 0 }}>{run.failedCount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-section" aria-labelledby="collectors-title">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">LATEST COLLECTORS</p>
          <h2 id="collectors-title">최근 수집원 진단</h2>
        </div>
        <div class="diagnostic-counts" aria-label="수집원 상태 요약">
          <span data-status="pass">성공 {diagnosticSummary.success}</span>
          <span data-status="warning">새 항목 없음 {diagnosticSummary.empty}</span>
          <span data-status="fail">오류 {diagnosticSummary.error}</span>
        </div>
      </div>
      {dashboard.latestDiagnostics.length > 0 ? (
        <ul class="diagnostic-list">
          {dashboard.latestDiagnostics.map((diagnostic) => (
            <li>
              <span class="collector-icon" data-status={diagnostic.status === "success" ? "pass" : diagnostic.status === "empty" ? "warning" : "fail"} aria-hidden="true">
                {diagnostic.status === "success" ? <Radio size={15} /> : diagnostic.status === "empty" ? <Clock3 size={15} /> : <CircleX size={15} />}
              </span>
              <span><strong>{diagnostic.source}</strong><small>{diagnostic.error ?? `${diagnostic.candidateCount}개 후보 확인`}</small></span>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-diagnostics"><Database size={24} /><span>수집원 진단 기록이 없습니다.</span></div>
      )}
    </section>
  </div>
</Base>

