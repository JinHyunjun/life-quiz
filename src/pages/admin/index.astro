<script>
  const feedbackActionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-feedback-action]"));
  const supportActionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-support-action]"));
  const actionStatus = document.querySelector<HTMLElement>("#admin-action-status");
  const supportActionStatus = document.querySelector<HTMLElement>("#support-action-status");
  const openSupportCount = document.querySelector<HTMLElement>("#open-support-count");
  const openCount = document.querySelector<HTMLElement>("#open-feedback-count");
  const runIngestionButton = document.querySelector<HTMLButtonElement>("#run-ingestion");
  const ingestionActionStatus = document.querySelector<HTMLElement>("#ingestion-action-status");

  runIngestionButton?.addEventListener("click", async () => {
    runIngestionButton.disabled = true;
    if (ingestionActionStatus) ingestionActionStatus.textContent = "누락 분야를 포함해 수집·검증을 실행하고 있습니다. 최대 2분 정도 걸릴 수 있습니다.";

    try {
      const response = await fetch("/api/admin/ingest", { method: "POST", headers: { accept: "application/json" } });
      const result = await response.json() as { created?: unknown[]; failed?: unknown[]; error?: string };
      if (!response.ok) throw new Error(result.error ?? "수집을 실행하지 못했습니다.");
      if (ingestionActionStatus) ingestionActionStatus.textContent = `생성 ${result.created?.length ?? 0}개 · 실패 ${result.failed?.length ?? 0}건. 최신 결과를 불러옵니다.`;
      window.setTimeout(() => window.location.reload(), 900);
    } catch (error) {
      runIngestionButton.disabled = false;
      if (ingestionActionStatus) ingestionActionStatus.textContent = error instanceof Error ? error.message : "잠시 후 다시 시도해주세요.";
    }
  });

  feedbackActionButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const feedbackId = Number(button.dataset.feedbackId);
      const status = button.dataset.feedbackAction;
      if (!Number.isInteger(feedbackId) || (status !== "resolved" && status !== "dismissed")) return;

      const row = document.querySelector<HTMLElement>(`[data-feedback-row="${feedbackId}"]`);
      row?.querySelectorAll<HTMLButtonElement>("button").forEach((rowButton) => { rowButton.disabled = true; });
      if (actionStatus) actionStatus.textContent = "제보 상태를 변경하는 중입니다.";

      try {
        const response = await fetch(`/api/admin/feedback/${feedbackId}`, {
          method: "PATCH",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ status }),
        });
        const result = await response.json() as { error?: string };
        if (!response.ok) throw new Error(result.error ?? "상태를 변경하지 못했습니다.");
        row?.remove();
        if (openCount) openCount.textContent = String(Math.max(0, Number(openCount.textContent) - 1));
        if (actionStatus) actionStatus.textContent = status === "resolved" ? "해결한 제보로 처리했습니다." : "보류한 제보로 처리했습니다.";
      } catch (error) {
        row?.querySelectorAll<HTMLButtonElement>("button").forEach((rowButton) => { rowButton.disabled = false; });
        if (actionStatus) actionStatus.textContent = error instanceof Error ? error.message : "잠시 후 다시 시도해주세요.";
      }
    });
  });

  supportActionButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const supportId = Number(button.dataset.supportId);
      const status = button.dataset.supportAction;
      if (!Number.isInteger(supportId) || !["in_progress", "resolved", "dismissed"].includes(status ?? "")) return;
      const row = document.querySelector<HTMLElement>(`[data-support-row="${supportId}"]`);
      row?.querySelectorAll<HTMLButtonElement>("button").forEach((rowButton) => { rowButton.disabled = true; });
      if (supportActionStatus) supportActionStatus.textContent = "문의 상태를 변경하고 있습니다.";

      try {
        const response = await fetch(`/api/admin/support/${supportId}`, {
          method: "PATCH",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ status }),
        });
        const result = await response.json() as { error?: string };
        if (!response.ok) throw new Error(result.error ?? "상태를 변경하지 못했습니다.");
        if (status === "in_progress") {
          if (openSupportCount) openSupportCount.textContent = String(Math.max(0, Number(openSupportCount.textContent) - 1));
          if (supportActionStatus) supportActionStatus.textContent = "처리 중인 문의로 표시했습니다.";
          window.setTimeout(() => window.location.reload(), 500);
        } else {
          if (row?.dataset.status === "open" && openSupportCount) openSupportCount.textContent = String(Math.max(0, Number(openSupportCount.textContent) - 1));
          row?.remove();
          if (supportActionStatus) supportActionStatus.textContent = status === "resolved" ? "해결한 문의로 처리했습니다." : "문의 처리를 종료했습니다.";
        }
      } catch (error) {
        row?.querySelectorAll<HTMLButtonElement>("button").forEach((rowButton) => { rowButton.disabled = false; });
        if (supportActionStatus) supportActionStatus.textContent = error instanceof Error ? error.message : "잠시 뒤 다시 시도해주세요.";
      }
    });
  });
</script>
