---
export const prerender = false;

import { env } from "cloudflare:workers";
import { ArrowRight, CalendarDays, ChartNoAxesColumnIncreasing, KeyRound, LogOut, MailCheck, RefreshCw, ShieldCheck, Trash2 } from "lucide-astro";
import Base from "../layouts/Base.astro";
import { getLifeQuizSession } from "../lib/auth";
import { createLifeQuizEmailSender } from "../lib/email";

const session = await getLifeQuizSession(Astro.request, env.DB, env.BETTER_AUTH_SECRET);
if (!session) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);

Astro.response.headers.set("cache-control", "no-store");
const joinedAt = new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "medium" }).format(session.user.createdAt);
const emailDeliveryEnabled = Boolean(createLifeQuizEmailSender(env));
---

<Base title="내 계정" description="라이프퀴즈 계정과 기기 간 학습 기록 동기화 상태">
  <div class="account-page shell" data-account-email={session.user.email}>
    <header class="account-header">
      <div>
        <p class="eyebrow">ACCOUNT &amp; SYNC</p>
        <h1 class="page-title">{session.user.name}님의 계정</h1>
        <p>{session.user.email}</p>
      </div>
      <button class="button button-secondary" type="button" id="sign-out"><LogOut size={17} /> 로그아웃</button>
    </header>

    <section class="sync-state" aria-labelledby="sync-title">
      <span class="sync-icon"><RefreshCw size={22} /></span>
      <div><h2 id="sync-title">학습 기록 동기화 중</h2><p id="sync-status" aria-live="polite">현재 브라우저에 남은 기록을 계정과 확인하고 있습니다.</p></div>
    </section>

    <div class="account-grid">
      <section class="account-details" aria-labelledby="details-title">
        <h2 id="details-title">계정 정보</h2>
        <dl>
          <div><dt>이름</dt><dd>{session.user.name}</dd></div>
          <div><dt>이메일</dt><dd>{session.user.email}</dd></div>
          <div><dt>확인 상태</dt><dd>{session.user.emailVerified ? "확인 완료" : "확인 전"}</dd></div>
          <div><dt>가입일</dt><dd>{joinedAt}</dd></div>
        </dl>
        <p><ShieldCheck size={15} /> 이메일은 로그인과 계정 구분에만 사용합니다.</p>
      </section>

      <nav class="account-actions" aria-label="학습 바로 가기">
        <a href="/daily"><span><CalendarDays size={19} /><strong>오늘의 5분 학습</strong></span><ArrowRight size={18} /></a>
        <a href="/me"><span><ChartNoAxesColumnIncreasing size={19} /><strong>내 학습 기록</strong></span><ArrowRight size={18} /></a>
      </nav>
    </div>

    <section class="security-section" aria-labelledby="security-title">
      <header><KeyRound size={20} /><div><h2 id="security-title">로그인 보안</h2><p>현재 비밀번호를 확인한 뒤 새 비밀번호로 바꿉니다.</p></div></header>
      <form class="security-form" id="change-password-form">
        <label>현재 비밀번호<input type="password" name="currentPassword" autocomplete="current-password" minlength="8" maxlength="128" required /></label>
        <label>새 비밀번호<input type="password" name="newPassword" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
        <button class="button button-secondary" type="submit"><KeyRound size={16} /> 비밀번호 변경</button>
        <p class="form-status" data-change-status aria-live="polite"></p>
      </form>

      {!session.user.emailVerified && (
        <div class="verification-row">
          <span><MailCheck size={18} /><span><strong>이메일 확인</strong><small>{emailDeliveryEnabled ? "확인 링크를 다시 받을 수 있습니다." : "발신 도메인 연결 뒤 확인 메일을 이용할 수 있습니다."}</small></span></span>
          <button class="button button-secondary" type="button" id="send-verification" disabled={!emailDeliveryEnabled}><MailCheck size={16} /> 확인 메일 보내기</button>
          <p class="form-status" data-verification-status aria-live="polite"></p>
        </div>
      )}
      <p class="recovery-note">비밀번호를 잊었다면 <a href="/forgot-password">재설정 링크 요청</a>을 이용하세요. 메일 전송이 준비되지 않은 경우에는 <a href="/support">문의·피드백</a>으로 안전하게 접수할 수 있습니다.</p>
    </section>

    <section class="danger-section" aria-labelledby="delete-title">
      <header><Trash2 size={20} /><div><h2 id="delete-title">계정과 학습 기록 삭제</h2><p>계정, 저장한 상식, 관심 분야, 학습·복습 기록을 즉시 영구 삭제합니다.</p></div></header>
      <form class="delete-form" id="delete-account-form">
        <label>현재 비밀번호<input type="password" name="password" autocomplete="current-password" minlength="8" maxlength="128" required /></label>
        <label>확인을 위해 <strong>삭제</strong> 입력<input type="text" name="confirmation" autocomplete="off" required /></label>
        <button class="button delete-button" type="submit"><Trash2 size={16} /> 계정 영구 삭제</button>
        <p class="form-status" data-delete-status aria-live="polite"></p>
      </form>
    </section>
  </div>
</Base>

<script>
  import { authClient } from "../lib/auth-client";
  import { clearAnonymousUserId, getAnonymousUserId } from "../lib/anonymous-user";
  import { trackProductEvent } from "../lib/product-events-client";

  const accountEmail = document.querySelector<HTMLElement>(".account-page")?.dataset.accountEmail ?? "";
  const status = document.querySelector<HTMLElement>("#sync-status");
  void fetch("/api/account/link", {
    method: "POST",
    headers: { "content-type": "application/json", accept: "application/json" },
    body: JSON.stringify({ anonymousUserId: getAnonymousUserId() }),
  }).then(async (response) => {
    if (!response.ok) throw new Error();
    const result = await response.json() as { linked?: boolean; movedRecords?: number };
    if (status) status.textContent = result.linked
      ? `이 브라우저의 기록 ${result.movedRecords ?? 0}건을 계정에 연결했습니다.`
      : "최신 상태입니다. 새 학습 기록은 이 계정에 저장됩니다.";
    if (result.linked) trackProductEvent("anonymous_data_linked");
  }).catch(() => {
    if (status) status.textContent = "동기화 상태를 확인하지 못했습니다. 페이지를 새로고침해주세요.";
  });

  document.querySelector<HTMLButtonElement>("#sign-out")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    await authClient.signOut();
    await fetch("/api/access/guest", { method: "DELETE" });
    window.location.assign("/login");
  });

  document.querySelector<HTMLButtonElement>("#send-verification")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const verificationStatus = document.querySelector<HTMLElement>("[data-verification-status]");
    button.disabled = true;
    if (verificationStatus) verificationStatus.textContent = "확인 메일을 준비하고 있습니다.";
    const result = await authClient.sendVerificationEmail({ email: accountEmail, callbackURL: "/account" });
    if (result.error) {
      if (verificationStatus) verificationStatus.textContent = "확인 메일을 보내지 못했습니다. 잠시 뒤 다시 시도해주세요.";
      button.disabled = false;
      return;
    }
    if (verificationStatus) verificationStatus.textContent = "확인 링크를 보냈습니다. 메일함을 확인해주세요.";
  });

  document.querySelector<HTMLFormElement>("#change-password-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const changeStatus = form.querySelector<HTMLElement>("[data-change-status]");
    const values = new FormData(form);
    if (submit) submit.disabled = true;
    if (changeStatus) changeStatus.textContent = "비밀번호를 변경하고 있습니다.";
    const result = await authClient.changePassword({
      currentPassword: String(values.get("currentPassword") ?? ""),
      newPassword: String(values.get("newPassword") ?? ""),
      revokeOtherSessions: true,
    });
    if (result.error) {
      if (changeStatus) changeStatus.textContent = /invalid password/i.test(result.error.message ?? "")
        ? "현재 비밀번호가 맞지 않습니다."
        : result.error.message ?? "비밀번호를 변경하지 못했습니다.";
      if (submit) submit.disabled = false;
      return;
    }
    form.reset();
    if (changeStatus) changeStatus.textContent = "비밀번호를 변경했습니다. 다른 기기의 로그인은 종료됩니다.";
    if (submit) submit.disabled = false;
  });

  document.querySelector<HTMLFormElement>("#delete-account-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const deleteStatus = form.querySelector<HTMLElement>("[data-delete-status]");
    const values = new FormData(form);
    if (String(values.get("confirmation") ?? "").trim() !== "삭제") {
      if (deleteStatus) deleteStatus.textContent = "확인란에 삭제를 정확히 입력해주세요.";
      return;
    }
    if (submit) submit.disabled = true;
    if (deleteStatus) deleteStatus.textContent = "계정과 학습 기록을 삭제하고 있습니다.";
    const result = await authClient.deleteUser({ password: String(values.get("password") ?? "") });
    if (result.error) {
      if (deleteStatus) deleteStatus.textContent = /invalid password/i.test(result.error.message ?? "")
        ? "현재 비밀번호가 맞지 않습니다."
        : result.error.message ?? "계정을 삭제하지 못했습니다.";
      if (submit) submit.disabled = false;
      return;
    }
    clearAnonymousUserId();
    await fetch("/api/access/guest", { method: "DELETE" });
    window.location.assign("/login?accountDeleted=1");
  });
</script>

<style>
  .account-page { max-width: 940px; padding-top: 72px; }
  .account-header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .account-header p:last-child { margin: 8px 0 0; color: var(--muted); }
  .sync-state { display: grid; grid-template-columns: 46px minmax(0, 1fr); align-items: center; gap: 14px; padding: 18px 0; border-block: 1px solid var(--line); }
  .sync-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: var(--radius-md); color: var(--green-deep); background: var(--green-soft); }
  .sync-state h2 { margin: 0; font-size: 1rem; }
  .sync-state p { margin: 3px 0 0; color: var(--muted); font-size: 0.8rem; }
  .account-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, 0.7fr); gap: 28px; margin-top: 34px; }
  .account-details h2 { margin: 0 0 14px; font-size: 1.05rem; }
  .account-details dl { margin: 0; border-top: 1px solid var(--line); }
  .account-details dl > div { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 18px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .account-details dt { color: var(--muted); font-size: 0.76rem; }
  .account-details dd { margin: 0; overflow-wrap: anywhere; font-size: 0.82rem; font-weight: 700; }
  .account-details > p { display: flex; align-items: center; gap: 6px; margin: 14px 0 0; color: var(--muted); font-size: 0.72rem; }
  .account-actions { display: grid; align-content: start; gap: 8px; }
  .account-actions a { min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); text-decoration: none; }
  .account-actions a:hover { border-color: var(--green); }
  .account-actions span { display: flex; align-items: center; gap: 9px; }
  .account-actions span svg { color: var(--green); }
  .account-actions strong { font-size: 0.82rem; }
  .security-section, .danger-section { margin-top: 42px; padding-top: 22px; border-top: 1px solid var(--line); }
  .security-section > header, .danger-section > header { display: flex; align-items: flex-start; gap: 10px; }
  .security-section > header svg { color: var(--green); }
  .danger-section > header svg { color: var(--coral); }
  .security-section h2, .danger-section h2 { margin: 0; font-size: 1rem; }
  .security-section header p, .danger-section header p { margin: 4px 0 0; color: var(--muted); font-size: 0.74rem; }
  .security-form, .delete-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) auto; align-items: end; gap: 10px; margin-top: 18px; }
  .security-form label, .delete-form label { display: grid; gap: 6px; color: var(--muted-strong); font-size: 0.72rem; font-weight: 750; }
  .security-form input, .delete-form input { min-height: 42px; padding: 0 11px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); background: var(--surface); }
  .form-status { grid-column: 1 / -1; min-height: 18px; margin: 0; color: var(--muted-strong); font-size: 0.7rem; }
  .verification-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
  .verification-row > span { display: flex; align-items: center; gap: 9px; }
  .verification-row > span > svg { color: var(--green); }
  .verification-row strong, .verification-row small { display: block; }
  .verification-row strong { font-size: 0.8rem; }
  .verification-row small { margin-top: 3px; color: var(--muted); font-size: 0.68rem; }
  .verification-row .form-status { grid-column: 1 / -1; }
  .recovery-note { margin: 14px 0 0; color: var(--muted); font-size: 0.7rem; }
  .recovery-note a { color: var(--green-deep); font-weight: 750; }
  .delete-button { color: white; background: var(--coral); }
  .delete-button:hover { filter: brightness(0.94); }
  .delete-button:disabled, .security-form button:disabled, .verification-row button:disabled { opacity: 0.58; cursor: wait; }
  @media (max-width: 720px) {
    .account-page { padding-top: 38px; }
    .account-header { align-items: start; }
    .account-grid { grid-template-columns: 1fr; }
    .security-form, .delete-form { grid-template-columns: 1fr; }
    .security-form .button, .delete-form .button, .verification-row .button { width: 100%; }
    .verification-row { grid-template-columns: 1fr; }
  }
</style>
