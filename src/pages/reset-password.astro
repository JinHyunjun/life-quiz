---
export const prerender = false;

import { ArrowLeft, KeyRound } from "lucide-astro";
import Base from "../layouts/Base.astro";

const token = Astro.url.searchParams.get("token")?.trim() ?? "";
---

<Base title="새 비밀번호 설정" description="라이프퀴즈 계정의 새 비밀번호를 설정합니다.">
  <main class="recovery-page shell" data-reset-token={token}>
    <a class="back-link" href="/login"><ArrowLeft size={16} /> 로그인으로 돌아가기</a>
    <header><p class="eyebrow">RESET PASSWORD</p><h1 class="page-title">새 비밀번호를 설정하세요</h1><p>다른 서비스에서 사용하지 않는 8자 이상의 비밀번호를 권장합니다.</p></header>
    {token ? (
      <form id="reset-password-form">
        <label>새 비밀번호<input type="password" name="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
        <label>새 비밀번호 확인<input type="password" name="confirmation" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
        <button class="button button-primary" type="submit"><KeyRound size={17} /> 비밀번호 저장</button>
        <p class="form-status" aria-live="polite" data-form-status></p>
      </form>
    ) : (
      <div class="invalid-link"><p>재설정 링크가 없거나 만료되었습니다.</p><a class="button button-secondary" href="/forgot-password">링크 다시 요청</a></div>
    )}
  </main>
</Base>

<script>
  import { authClient } from "../lib/auth-client";

  document.querySelector<HTMLFormElement>("#reset-password-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const values = new FormData(form);
    const password = String(values.get("password") ?? "");
    const confirmation = String(values.get("confirmation") ?? "");
    const token = document.querySelector<HTMLElement>(".recovery-page")?.dataset.resetToken ?? "";
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    if (password !== confirmation) {
      if (status) status.textContent = "두 비밀번호가 일치하지 않습니다.";
      return;
    }
    if (submit) submit.disabled = true;
    if (status) status.textContent = "새 비밀번호를 저장하고 있습니다.";
    const result = await authClient.resetPassword({ newPassword: password, token });
    if (result.error) {
      if (status) status.textContent = /token/i.test(result.error.message ?? "")
        ? "링크가 만료되었습니다. 재설정 링크를 다시 요청해주세요."
        : result.error.message ?? "비밀번호를 저장하지 못했습니다.";
      if (submit) submit.disabled = false;
      return;
    }
    window.location.assign("/login?passwordReset=1");
  });
</script>

<style>
  .recovery-page { max-width: 620px; padding-top: 72px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 28px; color: var(--muted-strong); font-size: 0.76rem; font-weight: 750; text-decoration: none; }
  header > p:last-child { margin: 10px 0 0; color: var(--muted); }
  form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) auto; align-items: end; gap: 10px; margin-top: 30px; padding-block: 22px; border-block: 1px solid var(--line); }
  label { display: grid; gap: 6px; color: var(--muted-strong); font-size: 0.74rem; font-weight: 750; }
  input { min-height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); background: var(--surface); }
  .form-status { grid-column: 1 / -1; min-height: 20px; margin: 0; color: var(--muted-strong); font-size: 0.72rem; }
  .invalid-link { margin-top: 30px; padding-block: 22px; border-block: 1px solid var(--line); }
  .invalid-link p { color: var(--muted); }
  @media (max-width: 700px) { .recovery-page { padding-top: 38px; } form { grid-template-columns: 1fr; } form .button { width: 100%; } }
</style>
