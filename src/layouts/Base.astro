---
import {
  Archive,
  BookOpenCheck,
  ChartNoAxesColumnIncreasing,
  Gauge,
  History,
  House,
  Map,
  Menu,
  MessageCircle,
  Moon,
  RotateCcw,
  Sparkles,
  Sun,
  X,
} from "lucide-astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "사회초년생에게 필요한 생활 상식을 읽고, 묻고, 오래 기억하는 라이프퀴즈",
} = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", label: "홈", mobileLabel: "홈", group: "탐색", icon: House, active: pathname === "/" || pathname.startsWith("/articles/"), mobile: true },
  { href: "/start", label: "시작 코스", mobileLabel: "시작", group: "탐색", icon: Map, active: pathname === "/start", mobile: false },
  { href: "/archive", label: "지난 상식", mobileLabel: "보관함", group: "탐색", icon: Archive, active: pathname.startsWith("/archive"), mobile: true },
  { href: "/daily", label: "5분 학습", mobileLabel: "5분 학습", group: "학습", icon: Sparkles, active: pathname === "/daily", mobile: true },
  { href: "/review", label: "전체 복습", mobileLabel: "복습", group: "학습", icon: RotateCcw, active: pathname === "/review", mobile: false },
  { href: "/chat", label: "라이프 메이트", mobileLabel: "AI 질문", group: "학습", icon: MessageCircle, active: pathname === "/chat", mobile: true },
  { href: "/me", label: "내 학습", mobileLabel: "내 학습", group: "기록", icon: ChartNoAxesColumnIncreasing, active: pathname === "/me", mobile: true },
  { href: "/changelog", label: "릴리즈 노트", mobileLabel: "업데이트", group: "기록", icon: History, active: pathname === "/changelog", mobile: false },
];
const navGroups = ["탐색", "학습", "기록"].map((label) => ({
  label,
  items: navItems.filter((item) => item.group === label),
}));
const mobileNavItems = navItems.filter((item) => item.mobile);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#f4f6f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | 라이프퀴즈</title>
    <script is:inline>
      (() => {
        const storageKey = "life-quiz-theme";
        let theme = "light";
        try {
          const savedTheme = localStorage.getItem(storageKey);
          if (savedTheme === "light" || savedTheme === "dark") theme = savedTheme;
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>

    <div class="app-shell">
      <aside class="site-sidebar" aria-label="라이프퀴즈 메뉴">
        <a class="brand" href="/" aria-label="라이프퀴즈 홈" title="라이프퀴즈 홈">
          <span class="brand-mark" aria-hidden="true"><BookOpenCheck size={21} strokeWidth={2.2} /></span>
          <span class="brand-copy">
            <strong>라이프퀴즈</strong>
            <small>읽고, 묻고, 오래 기억하기</small>
          </span>
        </a>

        <a class="sidebar-quick-start" href="/daily" title="오늘의 5분 학습 시작">
          <Sparkles size={18} strokeWidth={2.1} />
          <span><small>오늘의 루틴</small><strong>5분 학습 시작</strong></span>
        </a>

        <nav class="sidebar-nav" aria-label="주요 메뉴">
          {navGroups.map((group) => (
            <section class="nav-group" aria-labelledby={`nav-${group.label}`}>
              <h2 id={`nav-${group.label}`}>{group.label}</h2>
              <div class="nav-group-links">
                {group.items.map(({ href, label, icon: Icon, active }) => (
                  <a href={href} class:list={["nav-link", { active }]} aria-current={active ? "page" : undefined} title={label}>
                    <Icon size={19} strokeWidth={2} />
                    <span>{label}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </nav>

        <a class="sidebar-admin" href="/admin" title="운영 품질 대시보드">
          <Gauge size={18} />
          <span>운영 품질</span>
        </a>
      </aside>

      <div class="app-frame">
        <div class="app-tools">
          <div class="theme-switcher" role="group" aria-label="화면 모드 선택">
            <button type="button" data-theme-value="light" aria-label="라이트 모드" aria-pressed="true" title="라이트 모드">
              <Sun size={17} />
            </button>
            <button type="button" data-theme-value="dark" aria-label="다크 모드" aria-pressed="false" title="다크 모드">
              <Moon size={17} />
            </button>
          </div>
        </div>

        <header class="mobile-header">
          <a class="mobile-brand" href="/" aria-label="라이프퀴즈 홈">
            <span class="brand-mark" aria-hidden="true"><BookOpenCheck size={19} strokeWidth={2.2} /></span>
            <strong>라이프퀴즈</strong>
          </a>
          <button class="mobile-menu-button icon-button" type="button" aria-label="전체 메뉴 열기" aria-haspopup="dialog" aria-controls="mobile-menu">
            <Menu size={21} />
          </button>
        </header>

        <main id="main-content">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="shell footer-inner">
            <div>
              <strong>라이프퀴즈</strong>
              <p>출처를 확인하고, 내 말로 이해하고, 다시 만나는 지식.</p>
            </div>
            <div class="footer-meta">
              <div class="footer-links"><a href="/changelog">릴리즈 노트</a><a href="/admin">운영 대시보드</a></div>
              <p>중요한 결정 전에는 연결된 원문을 확인하세요.</p>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <dialog class="mobile-menu-dialog" id="mobile-menu" aria-labelledby="mobile-menu-title">
      <div class="mobile-menu-head">
        <div>
          <p>바로 가기</p>
          <h2 id="mobile-menu-title">전체 메뉴</h2>
        </div>
        <button class="mobile-menu-close icon-button" type="button" aria-label="전체 메뉴 닫기"><X size={21} /></button>
      </div>
      <nav class="mobile-menu-list" aria-label="모바일 전체 메뉴">
        {navItems.map(({ href, label, group, icon: Icon, active }) => (
          <a href={href} class:list={["mobile-menu-link", { active }]} aria-current={active ? "page" : undefined}>
            <span class="mobile-menu-icon"><Icon size={20} /></span>
            <span><strong>{label}</strong><small>{group}</small></span>
          </a>
        ))}
        <a href="/admin" class="mobile-menu-link">
          <span class="mobile-menu-icon"><Gauge size={20} /></span>
          <span><strong>운영 품질</strong><small>관리</small></span>
        </a>
      </nav>
    </dialog>

    <nav class="mobile-nav" aria-label="모바일 주요 메뉴">
      {mobileNavItems.map(({ href, mobileLabel, icon: Icon, active }) => (
        <a href={href} class:list={["mobile-nav-link", { active }]} aria-current={active ? "page" : undefined}>
          <Icon size={20} strokeWidth={2} />
          <span>{mobileLabel}</span>
        </a>
      ))}
    </nav>

    <script>
      const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");
      const openButton = document.querySelector<HTMLButtonElement>(".mobile-menu-button");
      const closeButton = document.querySelector<HTMLButtonElement>(".mobile-menu-close");

      openButton?.addEventListener("click", () => dialog?.showModal());
      closeButton?.addEventListener("click", () => dialog?.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      const themeStorageKey = "life-quiz-theme";
      const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-value]");
      const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");

      const applyTheme = (theme: "light" | "dark", persist = false) => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        themeColor?.setAttribute("content", theme === "dark" ? "#0f1412" : "#f4f6f4");
        themeButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.themeValue === theme));
        });
        if (persist) {
          try {
            localStorage.setItem(themeStorageKey, theme);
          } catch {}
        }
      };

      const initialTheme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      applyTheme(initialTheme);
      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const theme = button.dataset.themeValue;
          if (theme === "light" || theme === "dark") applyTheme(theme, true);
        });
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    transform: translateY(-150%);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--contrast-ink);
    background: var(--contrast-surface);
  }

  .skip-link:focus { transform: translateY(0); }

  .app-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
  }

  .site-sidebar {
    position: sticky;
    top: 0;
    z-index: 50;
    min-width: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 22px 16px 16px;
    overflow-y: auto;
    border-right: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 97%, var(--canvas));
  }

  .brand,
  .mobile-brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand { padding: 0 4px; }

  .brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    border-radius: var(--radius-md);
    color: white;
    background: var(--green);
  }

  .brand-copy {
    min-width: 0;
    display: grid;
    gap: 1px;
  }

  .brand-copy strong { font-size: 1rem; line-height: 1.2; }
  .brand-copy small { color: var(--muted); font-size: 0.68rem; white-space: nowrap; }

  .sidebar-quick-start {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 24px 0 20px;
    padding: 11px 12px;
    border-radius: var(--radius-md);
    color: white;
    background: var(--green);
    text-decoration: none;
  }

  .sidebar-quick-start > span { min-width: 0; display: grid; }
  .sidebar-quick-start small { color: #c8dfd4; font-size: 0.65rem; font-weight: 700; }
  .sidebar-quick-start strong { font-size: 0.85rem; white-space: nowrap; }

  .sidebar-nav { display: grid; gap: 16px; }

  .nav-group h2 {
    margin: 0 0 5px 10px;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .nav-group-links { display: grid; gap: 2px; }

  .nav-link {
    min-width: 0;
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    color: var(--muted-strong);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .nav-link svg { flex: 0 0 auto; }
  .nav-link:hover { color: var(--ink); background: var(--surface-strong); }
  .nav-link.active { color: var(--green-deep); background: var(--green-soft); }

  .sidebar-admin {
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding: 0 10px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .app-frame { min-width: 0; display: flex; flex-direction: column; }
  .app-frame main { min-width: 0; flex: 1; }
  .mobile-header { display: none; }

  .app-tools {
    position: fixed;
    top: 14px;
    right: 18px;
    z-index: 55;
  }

  .theme-switcher {
    width: 82px;
    height: 40px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(14px);
  }

  .theme-switcher button {
    min-width: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 5px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
  }

  .theme-switcher button:hover {
    color: var(--ink);
    background: var(--surface-strong);
  }

  .theme-switcher button[aria-pressed="true"] {
    color: var(--green-deep);
    background: var(--green-soft);
  }

  .site-footer {
    margin-top: 52px;
    padding: 24px 0 30px;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .footer-inner strong { color: var(--ink); }
  .footer-inner p { margin: 4px 0 0; }
  .footer-meta { display: grid; justify-items: end; }
  .footer-meta a { color: var(--ink); font-weight: 750; text-decoration: none; }
  .footer-links { display: flex; align-items: center; gap: 14px; }

  .mobile-menu-dialog,
  .mobile-nav { display: none; }

  @media (max-width: 1180px) and (min-width: 901px) {
    .app-shell { grid-template-columns: 78px minmax(0, 1fr); }
    .site-sidebar { padding-inline: 10px; align-items: center; }
    .brand { padding: 0; }
    .brand-copy,
    .sidebar-quick-start span,
    .nav-group h2,
    .nav-link span,
    .sidebar-admin span { display: none; }
    .sidebar-quick-start { width: 46px; min-height: 46px; justify-content: center; margin-block: 22px 18px; padding: 0; }
    .sidebar-nav,
    .nav-group-links { width: 100%; }
    .nav-group { display: contents; }
    .nav-link { justify-content: center; padding: 0; }
    .sidebar-admin { width: 44px; justify-content: center; padding: 0; }
  }

  @media (max-width: 900px) {
    .app-shell { display: block; }
    .site-sidebar { display: none; }
    .mobile-header {
      position: sticky;
      top: 0;
      z-index: 50;
      min-height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 16px;
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--paper) 95%, transparent);
      backdrop-filter: blur(14px);
    }
    .mobile-brand { font-size: 0.94rem; }
    .mobile-brand .brand-mark { width: 34px; height: 34px; flex-basis: 34px; }
    .mobile-menu-button { width: 40px; height: 40px; flex-basis: 40px; }
    .app-tools { top: 9px; right: 64px; }
    .theme-switcher { width: 76px; height: 40px; }

    .mobile-menu-dialog {
      width: min(430px, calc(100% - 24px));
      max-height: calc(100dvh - 32px);
      margin: auto;
      padding: 18px;
      overflow-y: auto;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      color: var(--ink);
      background: var(--paper);
      box-shadow: var(--shadow-lg);
    }
    .mobile-menu-dialog[open] { display: block; }
    .mobile-menu-dialog::backdrop { background: rgba(17, 28, 23, 0.52); backdrop-filter: blur(3px); }
    .mobile-menu-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .mobile-menu-head p { margin: 0; color: var(--green); font-size: 0.7rem; font-weight: 800; }
    .mobile-menu-head h2 { margin: 2px 0 0; font-size: 1.25rem; }
    .mobile-menu-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; margin-top: 18px; }
    .mobile-menu-link {
      min-width: 0;
      min-height: 58px;
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      align-items: center;
      gap: 9px;
      padding: 8px 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      color: var(--ink);
      background: var(--surface);
      text-decoration: none;
    }
    .mobile-menu-link.active { border-color: color-mix(in srgb, var(--green) 35%, var(--line)); background: var(--green-soft); }
    .mobile-menu-icon { width: 34px; height: 34px; display: grid; place-items: center; color: var(--green-deep); }
    .mobile-menu-link > span:last-child { min-width: 0; display: grid; }
    .mobile-menu-link strong { overflow: hidden; font-size: 0.8rem; text-overflow: ellipsis; white-space: nowrap; }
    .mobile-menu-link small { color: var(--muted); font-size: 0.66rem; }
  }

  @media (max-width: 720px) {
    .site-footer { display: none; }
    .mobile-nav {
      position: fixed;
      z-index: 60;
      right: 10px;
      bottom: max(10px, env(safe-area-inset-bottom));
      left: 10px;
      height: 62px;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: 5px;
      border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--paper) 96%, transparent);
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(16px);
    }
    .mobile-nav-link {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      border-radius: var(--radius-md);
      color: var(--muted);
      text-decoration: none;
      font-size: 0.65rem;
      font-weight: 700;
    }
    .mobile-nav-link.active { color: var(--green); background: var(--green-soft); }
  }

  @media (max-width: 390px) {
    .mobile-menu-list { grid-template-columns: 1fr; }
  }
</style>
