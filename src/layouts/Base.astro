---
import {
  Archive,
  BookOpenCheck,
  ChartNoAxesColumnIncreasing,
  Gauge,
  History,
  House,
  Map,
  Menu,
  MessageCircle,
  LifeBuoy,
  Moon,
  Network,
  RotateCcw,
  Search,
  Sparkles,
  Sun,
  UserRound,
  X,
} from "lucide-astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "사회초년생에게 필요한 생활 상식을 읽고, 묻고, 오래 기억하는 라이프퀴즈",
} = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", label: "홈", mobileLabel: "홈", group: "탐색", icon: House, active: pathname === "/" || pathname.startsWith("/articles/"), mobile: true },
  { href: "/start", label: "시작 코스", mobileLabel: "시작", group: "탐색", icon: Map, active: pathname === "/start", mobile: false },
  { href: "/topics", label: "지식 지도", mobileLabel: "지도", group: "탐색", icon: Network, active: pathname.startsWith("/topics"), mobile: false },
  { href: "/archive", label: "지난 상식", mobileLabel: "보관함", group: "탐색", icon: Archive, active: pathname.startsWith("/archive"), mobile: true },
  { href: "/daily", label: "5분 학습", mobileLabel: "5분 학습", group: "학습", icon: Sparkles, active: pathname === "/daily", mobile: true },
  { href: "/review", label: "전체 복습", mobileLabel: "복습", group: "학습", icon: RotateCcw, active: pathname === "/review", mobile: false },
  { href: "/chat", label: "라이프 메이트", mobileLabel: "AI 질문", group: "학습", icon: MessageCircle, active: pathname === "/chat", mobile: true },
  { href: "/me", label: "내 학습", mobileLabel: "내 학습", group: "나의 공간", icon: ChartNoAxesColumnIncreasing, active: pathname === "/me", mobile: true },
  { href: "/account", label: "계정·동기화", mobileLabel: "계정", group: "나의 공간", icon: UserRound, active: pathname === "/account" || pathname === "/login", mobile: false },
  { href: "/support", label: "문의·피드백", mobileLabel: "문의", group: "도움말", icon: LifeBuoy, active: pathname === "/support", mobile: false },
  { href: "/changelog", label: "릴리즈 노트", mobileLabel: "업데이트", group: "도움말", icon: History, active: pathname === "/changelog", mobile: false },
];
const navGroups = ["탐색", "학습", "나의 공간"].map((label) => ({
  label,
  items: navItems.filter((item) => item.group === label),
}));
const utilityItems = navItems.filter((item) => item.group === "도움말");
const mobileNavItems = navItems.filter((item) => item.mobile);
const currentPageLabel = navItems.find((item) => item.active)?.label ?? "라이프퀴즈";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#f4f6f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | 라이프퀴즈</title>
    <script is:inline>
      (() => {
        const storageKey = "life-quiz-theme";
        let theme = "light";
        try {
          const savedTheme = localStorage.getItem(storageKey);
          if (savedTheme === "light" || savedTheme === "dark") theme = savedTheme;
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>

    <div class="app-shell">
      <aside class="site-sidebar" aria-label="라이프퀴즈 메뉴">
        <a class="brand" href="/" aria-label="라이프퀴즈 홈" title="라이프퀴즈 홈">
          <span class="brand-mark" aria-hidden="true"><BookOpenCheck size={21} strokeWidth={2.2} /></span>
          <span class="brand-copy">
            <strong>라이프퀴즈</strong>
            <small>읽고, 묻고, 오래 기억하기</small>
          </span>
        </a>

        <a class="sidebar-quick-start" href="/daily" title="오늘의 5분 학습 시작">
          <Sparkles size={18} strokeWidth={2.1} />
          <span><small>오늘의 루틴</small><strong>5분 학습 시작</strong></span>
        </a>

        <nav class="sidebar-nav" aria-label="주요 메뉴">
          {navGroups.map((group) => (
            <section class="nav-group" aria-labelledby={`nav-${group.label}`}>
              <h2 id={`nav-${group.label}`}>{group.label}</h2>
              <div class="nav-group-links">
                {group.items.map(({ href, label, icon: Icon, active }) => (
                  <a href={href} class:list={["nav-link", { active }]} aria-current={active ? "page" : undefined} title={label}>
                    <Icon size={19} strokeWidth={2} />
                    <span>{label}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </nav>

        <div class="sidebar-utilities" aria-label="도움말과 관리">
          {utilityItems.map(({ href, label, icon: Icon, active }) => (
            <a href={href} class:list={["sidebar-utility-link", { active }]} title={label} aria-current={active ? "page" : undefined}>
              <Icon size={17} /><span>{label}</span>
            </a>
          ))}
          <a class="sidebar-utility-link" href="/admin" title="운영 품질 대시보드">
            <Gauge size={17} /><span>운영 품질</span>
          </a>
        </div>
      </aside>

      <div class="app-frame">
        <header class="desktop-topbar">
          <span class="page-context">{currentPageLabel}</span>
          <form class="global-search" action="/archive" method="get" role="search">
            <Search size={17} aria-hidden="true" />
            <label class="visually-hidden" for="global-search-query">전체 상식 검색</label>
            <input id="global-search-query" name="q" type="search" maxlength="60" placeholder="궁금한 상식을 검색하세요" />
            <button type="submit" aria-label="전체 상식 검색"><Search size={16} /></button>
          </form>
          <div class="topbar-actions">
          <a class="account-tool" href="/account" title="계정 및 학습 기록 동기화">
            <UserRound size={17} />
            <span>계정</span>
          </a>
          <div class="theme-switcher" role="group" aria-label="화면 모드 선택">
            <button type="button" data-theme-value="light" aria-label="라이트 모드" aria-pressed="true" title="라이트 모드">
              <Sun size={17} />
            </button>
            <button type="button" data-theme-value="dark" aria-label="다크 모드" aria-pressed="false" title="다크 모드">
              <Moon size={17} />
            </button>
          </div>
          </div>
        </header>

        <header class="mobile-header">
          <a class="mobile-brand" href="/" aria-label="라이프퀴즈 홈">
            <span class="brand-mark" aria-hidden="true"><BookOpenCheck size={19} strokeWidth={2.2} /></span>
            <strong>라이프퀴즈</strong>
          </a>
          <div class="mobile-header-actions">
            <a class="mobile-search-button icon-button" href="/archive#archive-query" aria-label="상식 검색" title="상식 검색"><Search size={19} /></a>
            <div class="theme-switcher" role="group" aria-label="화면 모드 선택">
              <button type="button" data-theme-value="light" aria-label="라이트 모드" aria-pressed="true" title="라이트 모드"><Sun size={16} /></button>
              <button type="button" data-theme-value="dark" aria-label="다크 모드" aria-pressed="false" title="다크 모드"><Moon size={16} /></button>
            </div>
            <button class="mobile-menu-button icon-button" type="button" aria-label="전체 메뉴 열기" aria-haspopup="dialog" aria-controls="mobile-menu">
              <Menu size={21} />
            </button>
          </div>
        </header>

        <main id="main-content">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="shell footer-inner">
            <div>
              <strong>라이프퀴즈</strong>
              <p>출처를 확인하고, 내 말로 이해하고, 다시 만나는 지식.</p>
            </div>
            <div class="footer-meta">
              <div class="footer-links"><a href="/support">문의·피드백</a><a href="/changelog">릴리즈 노트</a><a href="/privacy">개인정보</a><a href="/terms">이용약관</a><a href="/admin">운영 대시보드</a></div>
              <p>중요한 결정 전에는 연결된 원문을 확인하세요.</p>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <dialog class="mobile-menu-dialog" id="mobile-menu" aria-labelledby="mobile-menu-title">
      <div class="mobile-menu-head">
        <div>
          <p>바로 가기</p>
          <h2 id="mobile-menu-title">전체 메뉴</h2>
        </div>
        <button class="mobile-menu-close icon-button" type="button" aria-label="전체 메뉴 닫기"><X size={21} /></button>
      </div>
      <nav class="mobile-menu-list" aria-label="모바일 전체 메뉴">
        {navItems.map(({ href, label, group, icon: Icon, active }) => (
          <a href={href} class:list={["mobile-menu-link", { active }]} aria-current={active ? "page" : undefined}>
            <span class="mobile-menu-icon"><Icon size={20} /></span>
            <span><strong>{label}</strong><small>{group}</small></span>
          </a>
        ))}
        <a href="/admin" class="mobile-menu-link">
          <span class="mobile-menu-icon"><Gauge size={20} /></span>
          <span><strong>운영 품질</strong><small>관리</small></span>
        </a>
      </nav>
    </dialog>

    <nav class="mobile-nav" aria-label="모바일 주요 메뉴">
      {mobileNavItems.map(({ href, mobileLabel, icon: Icon, active }) => (
        <a href={href} class:list={["mobile-nav-link", { active }]} aria-current={active ? "page" : undefined}>
          <Icon size={20} strokeWidth={2} />
          <span>{mobileLabel}</span>
        </a>
      ))}
    </nav>

    <script>
      import { trackProductEvent } from "../lib/product-events-client";

      const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");
      const openButton = document.querySelector<HTMLButtonElement>(".mobile-menu-button");
      const closeButton = document.querySelector<HTMLButtonElement>(".mobile-menu-close");

      openButton?.addEventListener("click", () => dialog?.showModal());
      closeButton?.addEventListener("click", () => dialog?.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      const themeStorageKey = "life-quiz-theme";
      const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-value]");
      const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");

      const applyTheme = (theme: "light" | "dark", persist = false) => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        themeColor?.setAttribute("content", theme === "dark" ? "#0f1412" : "#f4f6f4");
        themeButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.themeValue === theme));
        });
        if (persist) {
          try {
            localStorage.setItem(themeStorageKey, theme);
          } catch {}
        }
      };

      const initialTheme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      applyTheme(initialTheme);
      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const theme = button.dataset.themeValue;
          if (theme === "light" || theme === "dark") applyTheme(theme, true);
        });
      });

      const kstDate = new Date(Date.now() + 9 * 60 * 60 * 1_000).toISOString().slice(0, 10);
      trackProductEvent("site_visit", {}, { oncePerSessionKey: `site-visit:${kstDate}` });
      if (window.location.pathname === "/") {
        trackProductEvent("home_view", {}, { oncePerSessionKey: `home-view:${kstDate}` });
      }

    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    transform: translateY(-150%);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--contrast-ink);
    background: var(--contrast-surface);
  }

  .skip-link:focus { transform: translateY(0); }

  .app-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
  }

  .site-sidebar {
    position: sticky;
    top: 0;
    z-index: 50;
    min-width: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 22px 16px 16px;
    overflow-y: auto;
    border-right: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 97%, var(--canvas));
  }

  .brand,
  .mobile-brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand { padding: 0 4px; }

  .brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    border-radius: var(--radius-md);
    color: white;
    background: var(--green);
  }

  .brand-copy {
    min-width: 0;
    display: grid;
    gap: 1px;
  }

  .brand-copy strong { font-size: 1rem; line-height: 1.2; }
  .brand-copy small { color: var(--muted); font-size: 0.68rem; white-space: nowrap; }

  .sidebar-quick-start {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 24px 0 20px;
    padding: 11px 12px;
    border-radius: var(--radius-md);
    color: white;
    background: var(--green);
    text-decoration: none;
  }

  .sidebar-quick-start > span { min-width: 0; display: grid; }
  .sidebar-quick-start small { color: #c8dfd4; font-size: 0.65rem; font-weight: 700; }
  .sidebar-quick-start strong { font-size: 0.85rem; white-space: nowrap; }

  .sidebar-nav { display: grid; gap: 16px; }

  .nav-group h2 {
    margin: 0 0 5px 10px;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .nav-group-links { display: grid; gap: 2px; }

  .nav-link {
    min-width: 0;
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    color: var(--muted-strong);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .nav-link svg { flex: 0 0 auto; }
  .nav-link:hover { color: var(--ink); background: var(--surface-strong); }
  .nav-link.active { color: var(--green-deep); background: var(--green-soft); }

  .sidebar-utilities {
    display: grid;
    gap: 2px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .sidebar-utility-link {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.73rem;
    font-weight: 700;
  }

  .sidebar-utility-link:hover,
  .sidebar-utility-link.active { color: var(--ink); background: var(--surface-strong); }

  .app-frame { min-width: 0; display: flex; flex-direction: column; }
  .app-frame main { min-width: 0; flex: 1; }
  .mobile-header { display: none; }

  .desktop-topbar {
    position: sticky;
    top: 0;
    z-index: 45;
    min-height: 64px;
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(260px, 440px) minmax(120px, 1fr);
    align-items: center;
    gap: 18px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(16px);
  }

  .page-context {
    color: var(--muted-strong);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .global-search {
    min-width: 0;
    height: 42px;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 8px;
    padding: 0 4px 0 13px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--muted);
    background: var(--surface);
  }

  .global-search:focus-within {
    border-color: color-mix(in srgb, var(--green) 50%, var(--line));
    background: var(--paper);
  }

  .global-search input {
    min-width: 0;
    border: 0;
    background: transparent;
  }

  .global-search input::placeholder { color: var(--muted); }
  .global-search button {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--green-deep);
    background: transparent;
    cursor: pointer;
  }
  .global-search button:hover { background: var(--green-soft); }

  .topbar-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
  }

  .account-tool {
    height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--muted-strong);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    text-decoration: none;
    font-size: 0.76rem;
    font-weight: 750;
  }

  .account-tool:hover { color: var(--green-deep); background: var(--green-soft); }

  .theme-switcher {
    width: 82px;
    height: 40px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
  }

  .theme-switcher button {
    min-width: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 5px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
  }

  .theme-switcher button:hover {
    color: var(--ink);
    background: var(--surface-strong);
  }

  .theme-switcher button[aria-pressed="true"] {
    color: var(--green-deep);
    background: var(--green-soft);
  }

  .site-footer {
    margin-top: 52px;
    padding: 24px 0 30px;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .footer-inner strong { color: var(--ink); }
  .footer-inner p { margin: 4px 0 0; }
  .footer-meta { display: grid; justify-items: end; }
  .footer-meta a { color: var(--ink); font-weight: 750; text-decoration: none; }
  .footer-links { display: flex; align-items: center; gap: 14px; }

  .mobile-menu-dialog,
  .mobile-nav { display: none; }

  @media (max-width: 1180px) and (min-width: 901px) {
    .app-shell { grid-template-columns: 78px minmax(0, 1fr); }
    .site-sidebar { padding-inline: 10px; align-items: center; }
    .brand { padding: 0; }
    .brand-copy,
    .sidebar-quick-start span,
    .nav-group h2,
    .nav-link span,
    .sidebar-utility-link span { display: none; }
    .sidebar-quick-start { width: 46px; min-height: 46px; justify-content: center; margin-block: 22px 18px; padding: 0; }
    .sidebar-nav,
    .nav-group-links { width: 100%; }
    .nav-group { display: contents; }
    .nav-link { justify-content: center; padding: 0; }
    .sidebar-utilities { width: 100%; }
    .sidebar-utility-link { justify-content: center; padding: 0; }
  }

  @media (max-width: 900px) {
    .app-shell { display: block; }
    .site-sidebar { display: none; }
    .desktop-topbar { display: none; }
    .mobile-header {
      position: sticky;
      top: 0;
      z-index: 50;
      min-height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 16px;
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--paper) 95%, transparent);
      backdrop-filter: blur(14px);
    }
    .mobile-brand { font-size: 0.94rem; }
    .mobile-brand .brand-mark { width: 34px; height: 34px; flex-basis: 34px; }
    .mobile-header-actions { display: flex; align-items: center; gap: 6px; }
    .mobile-search-button,
    .mobile-menu-button { width: 38px; height: 38px; flex-basis: 38px; color: var(--muted-strong); }
    .theme-switcher { width: 72px; height: 38px; }

    .mobile-menu-dialog {
      width: min(430px, calc(100% - 24px));
      max-height: calc(100dvh - 32px);
      margin: auto;
      padding: 18px;
      overflow-y: auto;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      color: var(--ink);
      background: var(--paper);
      box-shadow: var(--shadow-lg);
    }
    .mobile-menu-dialog[open] { display: block; }
    .mobile-menu-dialog::backdrop { background: rgba(17, 28, 23, 0.52); backdrop-filter: blur(3px); }
    .mobile-menu-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .mobile-menu-head p { margin: 0; color: var(--green); font-size: 0.7rem; font-weight: 800; }
    .mobile-menu-head h2 { margin: 2px 0 0; font-size: 1.25rem; }
    .mobile-menu-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; margin-top: 18px; }
